#!/usr/bin/env python3
"""Give every registered crew its own pair of ops credentials.

    mint-crew-ops-credentials
    mint-crew-ops-credentials --dry-run

**The problem this closes.** `bin/mcp-ops-server` refuses every call unless
`ORIENT_OPS_CREW_TOKEN_FILE` names a readable file, with no fallback to a
shared token. `bin/co` and `bin/agentctl` already set that variable to one
crew's own file — `~/.orient-control/ops-co-<slug>-token` for a crew's
session, `~/.orient-control/ops-<slug>-token` for a dispatched run — but
nothing minted either file. This command does: for every crew the project
registry carries, that the registry does not mark private, it mints the pair
that is missing and leaves what is already there alone.

**The pair.** Each crew gets two agents-file entries, both carrying the
crew's own name as `crew`:

| entry | extra grant | file |
|---|---|---|
| `ops-<crew>` | none | `ops-<crew>-token` |
| `ops-co-<crew>` | `item.create` | `ops-co-<crew>-token` |

A crew whose every registered unit is private gets neither — a black-box
crew runs with no kb or ops tools at all, so it has nothing to present.

**Never `--replace`.** A file already there is left alone, and a store entry
already there with no file is reported rather than overwritten — minting a
second credential under the same name would leave the first one, whatever
held it, still valid and now undiscoverable.

**Why this reads the registry from the database directly, never over
`GET /registry`.** The Library's own `jobs/library.toml` runs this from its
`prepare`, before the Library is serving anything — the registry lives in
one table in the Library's own database, so prepare already reads and
writes that database directly (the roster and profile loads beside this one
do the same). Reading the table directly, rather than over the wire, is also
what lets the very same command run from the `new-crew` skill, right after
`agentctl crew register`, and from an operator's own shell — one code path
for all three, none of them needing the Library to be up.

**Why a crew, not a project slug.** The registry's `crew` field is what
`bin/co` resolves a repository to (`projects.crew_for_repo`), and two
projects can share one crew — a sub-crew registered under `--home-dir`
alongside its parent, in `new-crew`'s own example. The pair belongs to the
crew, not to each project slug that names it, so this mints one pair per
distinct `crew` value, keyed on it being present on at least one non-private
unit.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sqlite3
import subprocess
import sys
from pathlib import Path

PROG = "mint-crew-ops-credentials"

DEFAULT_DEPLOY_ROOT = Path.home() / ".local" / "deploy"
DEFAULT_STATE_ROOT = Path.home() / ".local" / "state"

# A registry slug, and by extension a `crew` value, is already constrained to
# this shape at the point it is written: a lowercase letter, then lowercase
# letters, digits or hyphens, at most 64 characters. Checked again here
# because this value becomes a filename below; a row that somehow fails it is
# reported rather than trusted.
CREW_RE = re.compile(r"^[a-z][a-z0-9-]{0,63}$")

# One pair per crew: (entry name template, file name template, extra grant).
PAIR = (
    ("ops-{crew}", "ops-{crew}-token", None),
    ("ops-co-{crew}", "ops-co-{crew}-token", "item.create"),
)


class Refused(Exception):
    """Why nothing more could be minted. Never a stack trace."""


def registered_crews(db_path: Path) -> dict[str, bool]:
    """Every crew the registry carries, mapped to whether EVERY unit naming
    it is private — the one case excluded from the pair.

    Reads the `project_registry` table directly, the same shape the
    Library's own source reads it in, reproduced here rather than imported
    from it, since this command must not depend on a change to the Library
    to run."""
    if not db_path.is_file():
        raise Refused(f"{db_path} does not exist; the Library has not been migrated yet")
    try:
        conn = sqlite3.connect(str(db_path))
    except sqlite3.Error as exc:
        raise Refused(f"{db_path} could not be opened: {exc}")
    try:
        try:
            rows = conn.execute("SELECT slug, entry FROM project_registry").fetchall()
        except sqlite3.OperationalError as exc:
            raise Refused(f"{db_path} has no project_registry table yet: {exc}")
    finally:
        conn.close()

    crews: dict[str, bool] = {}
    for slug, entry_text in rows:
        # A slug starting with `_` is registry metadata (`_meta`, `_products`,
        # `_scopes`), not a crew, and need not be an object. Every seeded
        # table holds those rows, so treating one as a crew fails the install.
        if slug.startswith("_"):
            continue
        try:
            entry = json.loads(entry_text)
        except ValueError as exc:
            raise Refused(f"{db_path}: {slug!r}'s entry is not valid JSON: {exc}")
        if not isinstance(entry, dict):
            raise Refused(f"{db_path}: {slug!r}'s entry is not a JSON object")
        crew = entry.get("crew")
        crew = crew if isinstance(crew, str) and crew else slug
        private_unit = entry.get("private") is True
        # A crew stays excluded only while EVERY unit naming it is private —
        # one non-private unit sharing the crew means that crew does
        # real, indexed work and its session needs the tools.
        crews[crew] = private_unit if crew not in crews else (crews[crew] and private_unit)
    return crews


def mint(*, venv_python: Path, mint_script: Path, library_dir: Path, tokens_file: Path,
         name: str, crew: str, grants: str | None, out: Path) -> None:
    argv = [str(venv_python), str(mint_script), "--file", "agents", "--name", name,
            "--crew", crew, "--products", "*", "--tokens-file", str(tokens_file),
            "--out", str(out)]
    if grants:
        argv += ["--grants", grants]
    result = subprocess.run(argv, cwd=str(library_dir), capture_output=True, text=True)
    if result.returncode != 0:
        raise Refused((result.stderr or result.stdout or
                       f"mint_credential.py exited {result.returncode}").strip())


def recovery_command(*, library_dir: Path, tokens_file: Path, name: str, crew: str,
                     grants: str | None, out: Path) -> str:
    """The hand-run command that replaces a store entry whose file is gone —
    the same shape `installing.md`'s own recovery section already uses for
    the Library's other credentials, with `--replace` this command itself
    never passes."""
    grants_part = f" --grants {grants}" if grants else ""
    return (f"cd {library_dir} && .venv/bin/python mint_credential.py --file agents "
            f"--name {name} --crew {crew} --products '*'{grants_part} "
            f"--tokens-file {tokens_file} --out {out} --replace")


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Mint the ops credential pair for every registered crew missing one.",
    )
    parser.add_argument("--library-db", type=Path, default=None,
                        help="the Library's database (default: $LIBRARY_DB, or "
                             "~/.local/state/library/library.db)")
    parser.add_argument("--tokens-file", type=Path, default=None,
                        help="the agents token store (default: $LIBRARY_API_TOKENS, or "
                             "~/.local/state/library/api-tokens.json)")
    parser.add_argument("--library-dir", type=Path, default=None,
                        help="the Library's own deploy area, holding .venv and "
                             "mint_credential.py (default: $BUILDER_DEPLOY_ROOT/library, "
                             "or ~/.local/deploy/library)")
    parser.add_argument("--orient-control", type=Path, default=None,
                        help="where the credential files go (default: ~/.orient-control)")
    parser.add_argument("--dry-run", action="store_true",
                        help="say what would be minted; change nothing")
    args = parser.parse_args(argv)

    deploy_root = Path(os.environ.get("BUILDER_DEPLOY_ROOT") or DEFAULT_DEPLOY_ROOT).expanduser()
    library_db = (args.library_db or
                 Path(os.environ.get("LIBRARY_DB") or DEFAULT_STATE_ROOT / "library" / "library.db")
                 ).expanduser()
    tokens_file = (args.tokens_file or
                  Path(os.environ.get("LIBRARY_API_TOKENS") or
                       DEFAULT_STATE_ROOT / "library" / "api-tokens.json")).expanduser()
    library_dir = (args.library_dir or (deploy_root / "library")).expanduser()
    orient_control = (args.orient_control or (Path.home() / ".orient-control")).expanduser()
    venv_python = library_dir / ".venv" / "bin" / "python"
    mint_script = library_dir / "mint_credential.py"

    try:
        crews = registered_crews(library_db)
    except Refused as exc:
        print(f"{PROG}: refusing — {exc}", file=sys.stderr)
        return 1

    minted: list[str] = []
    present: list[str] = []
    private_skipped: list[str] = []
    failed: list[tuple[str, str, str]] = []  # (name, reason, recovery or "")

    for crew in sorted(crews):
        if crews[crew]:
            private_skipped.append(crew)
            continue
        if not CREW_RE.match(crew):
            failed.append((
                crew,
                f"{crew!r} does not match the registry's own slug rule; refusing to "
                f"build a filename from it",
                "",
            ))
            continue
        for name_tpl, file_tpl, grants in PAIR:
            name = name_tpl.format(crew=crew)
            out = orient_control / file_tpl.format(crew=crew)
            if out.exists():
                present.append(name)
                continue
            if args.dry_run:
                print(f"{PROG}: would mint {name} -> {out}")
                continue
            try:
                mint(venv_python=venv_python, mint_script=mint_script,
                     library_dir=library_dir, tokens_file=tokens_file,
                     name=name, crew=crew, grants=grants, out=out)
            except Refused as exc:
                recovery = ""
                if "already has a credential" in str(exc):
                    recovery = recovery_command(
                        library_dir=library_dir, tokens_file=tokens_file,
                        name=name, crew=crew, grants=grants, out=out)
                failed.append((name, str(exc), recovery))
                continue
            minted.append(name)

    for name in minted:
        print(f"{PROG}: minted {name}")

    if failed:
        print(f"{PROG}: {len(failed)} credential(s) could not be minted:", file=sys.stderr)
        for name, reason, recovery in failed:
            print(f"  {name}: {reason}", file=sys.stderr)
            if recovery:
                print(f"    the store already holds a credential for {name!r} but its "
                      f"file is gone; replace it by hand:", file=sys.stderr)
                print(f"    {recovery}", file=sys.stderr)
        return 1

    if not args.dry_run:
        print(f"{PROG}: {len(minted)} minted, {len(present)} already present, "
              f"{len(private_skipped)} private crew(s) skipped")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
