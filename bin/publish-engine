PROG = "publish-engine"
BIN = Path(__file__).resolve().parent
REPO = BIN.parent

# Written into every tree this tool builds, and the only thing that makes a
# directory eligible for --force to replace.
BUILD_MARKER = ".built-by-publish-engine"


def load(name: str, path: Path):
    """A sibling script as a module, refusing when it is not there."""
    if not path.is_file():
        raise SystemExit(f"{PROG}: {path} is missing; nothing was built")
    spec = importlib.util.spec_from_loader(
        name, importlib.machinery.SourceFileLoader(name, str(path))
    )
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


# THE SHARED PIECES COME FROM publish-payload rather than being copied, so a
# fix to how a ref is resolved or a licence file is read reaches both exports.
payload = load("publish_payload", BIN / "publish-payload")
Refused = payload.Refused
run = payload.run

# Every engine repository: all of publish-payload's but the one it exports.
ENGINES = tuple(name for name in payload.KNOWN_REPOSITORIES if name != "shipwright")

# PATHS LEFT OUT OF EACH EXPORT, as git pathspecs. Empty to start: each owner
# decides what crosses, and until they do the gate refuses what is not clean.
EXCLUDE: dict[str, tuple[str, ...]] = {name: () for name in ENGINES}
# agent-platform's `config/projects.json` is Convivy's own projects registry: it
# names the company's crews, its private crews and the people behind them, and
# the private-crew rule keeps all of that off an adopter's machine. Its owner
# ruled it out of the export. The release carries `config/projects.seed.json`,
# and `install-backend` writes the registry from that.
EXCLUDE["agent-platform"] = ("config/projects.json",)
# convivy-deck's `inbox/` holds memos between Convivy's crews, which are
# correspondence rather than product. Its `.github/workflows/ci.yml` runs on a
# self-hosted runner that exists only on Convivy's machine, so it cannot run in
# a public repository; an adopter builds and tests with `swift build` and
# `swift test`. Its owner ruled both out of the export.
EXCLUDE["convivy-deck"] = ("inbox", ".github/workflows/ci.yml")

# FILES LEFT OUT OF EACH EXPORT WHOSE PATH IS ITSELF PRIVATE, as (sha256 of the
# exact tracked path, reason). This file ships, and the purity checker refuses
# a machine's name in it, so a path that carries one is pinned by its hash the
# way an ALLOW entry pins a value. Each entry is one file, never a directory,
# and is matched against the paths tracked at the exported commit.
EXCLUDE_HASHED: dict[str, tuple[tuple[str, str], ...]] = {name: () for name in ENGINES}
# Four tools set up one operator's own pair of Macs (volume mounts, and an ssh
# config naming that operator's tailnet hosts and user), and the fifth is a
# bash test that pins the ssh tool's hostnames and cannot run without it. An
# adopter has none of those machines. agent-platform's owner ruled all five out.
EXCLUDE_HASHED["agent-platform"] = (
    ("7843404144ed9d99e0a507fcbb1d76512d6b94ab1b3776cd704b75036a404f87",
     "a tool that mounts one operator's volumes"),
    ("eb993213f4ec159ed4765aeababc13e116b01c5ea8d30a4552b4a20434223446",
     "a tool that remounts one operator's volumes"),
    ("5e063469c7155bd88bc01091cf84eab846405592a7e6023d3431b11e48524f46",
     "the retired predecessor of the remount tool"),
    ("a842d2243efd2f981444844e7682e0235a007f89541009ee23e30da37ae82128",
     "a tool that writes an ssh config naming one operator's hosts and user"),
    ("515ca98957dcb7a346961974afb88c1dc77d6bbb836ed5509e55fef56b0930bb",
     "the bash test of that ssh config tool, which pins its hostnames"),
)


def hashed_exclusions(name: str, root: Path, commit: str) -> list[str]:
    """The tracked paths at `commit` that an EXCLUDE_HASHED entry names."""
    pinned = {digest for digest, _ in EXCLUDE_HASHED[name]}
    if not pinned:
        return []
    result = subprocess.run(
        ["git", "-C", str(root), "ls-tree", "-r", "-z", "--name-only", commit],
        capture_output=True, check=False,
    )
    if result.returncode != 0:
        raise Refused(
            f"could not list {name} at {commit}: "
            f"{scrubbed(result.stderr.decode(errors='replace').strip())}"
        )
    paths = result.stdout.decode("utf-8", "surrogateescape").split("\0")
    return [path for path in paths if path and fingerprint(path) in pinned]

# FINDINGS ACCEPTED IN EACH EXPORT, as (path, kind, fingerprint, reason). Empty
# to start. This is for a redaction fixture, which is synthetic by construction:
# a test asserting that a scrubber turns a token into `[redacted]` has to carry
# a token. Every entry needs its reason, because an exemption without one
# becomes a hole nobody remembers agreeing to.
#
# THE FINGERPRINT PINS THE ENTRY TO ONE VALUE: the sha256 of the exact text the
# detector matched, computed by fingerprint(). An entry keyed on file and kind
# alone cleared every value of that kind in the file, so a real address added
# beside the fixture, or swapped in for it, shipped with no finding (security
# review: convivy-orient's main held a different address on the very line its
# allowance covers). The hash stores no value in this public file.
ALLOW: dict[str, tuple[tuple[str, str, str, str], ...]] = {name: () for name in ENGINES}

# THE CONTENT SCAN'S PATTERNS ARE THE PURITY CHECKER'S, SELECTED BY LABEL, so
# a pattern fixed there is fixed here. A label missing from the checker is a
# refusal rather than a smaller scan: a relabel there must not silently drop a
# category here. The checker's internal-id, company-domain, repository-reference
# and crew-name categories are left out, because they describe the payload's
# vocabulary rather than a person, a machine or a credential. Its person's-name
# pattern and its launchd label are in, since a person and a machine are what
# this scan exists to keep out (security review, round 1).
PERSON = ("a person's name",)
HOME = (
    "a macOS home directory path",
    "a Linux home directory path",
    "a Windows home directory path",
)
