# What the classifier reads, and which keys it treats as secret-shaped.
CONFIG_SUFFIXES = (".json", ".toml", ".yaml", ".yml", ".ini", ".cfg", ".env")
SECRET_KEY = re.compile(
    r"secret|token|password|passwd|api[_-]?key|private[_-]?key|credential", re.IGNORECASE
)
INLINE = "an inline value under a secret-shaped key"
# A GitHub Actions expression (`${{ ... }}`) and opencode's `{env:NAME}` are
# references too: the first is how every workflow passes its token, and the
# second is how an opencode provider names its key. Each was reported as an
# inline value in the first run against the real repositories.
#
# EVERY FORM IS A BARE NAME AND NOTHING ELSE. A reference that can carry a
# literal beside the name is not a reference: `${KEY:-value}`,
# `os.environ.get("KEY", "value")` and `${{ secrets.KEY || 'value' }}` each
# hold a value that is used whenever the variable is unset, which is where a
# real secret gets written (security review, round 1). The one modifier kept is
# `${KEY:?message}`, which fails when the variable is unset and holds no value.
_NAME = r"[A-Za-z_][A-Za-z0-9_]*"
ENV_REFERENCE = re.compile(
    rf"\$\{{\{{\s*{_NAME}(?:\.{_NAME})*\s*\}}\}}"
    rf"|\{{env:{_NAME}\}}"
    rf"|\$\{{{_NAME}(?::?\?[^}}]*)?\}}"
    rf"|\${_NAME}"
    rf"|os\.environ(?:/{_NAME}|\[[\"']{_NAME}[\"']\]|\.get\([\"']{_NAME}[\"']\))"
    rf"|env:{_NAME}"
)
# A `key: value` or `key = value` line, with the key optionally quoted and an
# `export` in front, as YAML, dotenv, INI and a JSON line each write one.
KEY_LINE = re.compile(
    r"""^\s*(?:export\s+)?["']?([A-Za-z0-9_.-]+)["']?\s*[:=]\s*(.*?)\s*,?\s*$"""
)
# Stands in for a YAML block scalar, whose value is on the lines below its key.
BLOCK = object()


@functools.cache
def _checker(path: Path):
    return load("check_payload_purity", path)


def withheld(text: str) -> str:
    """`text` as a finding may print it: a path segment or a config key name.

    A name is content too. A file named for an address or a token prints that
    value in every finding about it, and so does a JSON or TOML key holding
    one, on a build that passes as well as one that refuses (security review,
    rounds 1 and 2). Those two kinds are withheld, and so is a private
    person's name or one of the operator's machine names: those lists exist to
    keep the names out of anything passed along, and finding text gets passed
    along (security review of the machine names, round 1). The segment alone is withheld, so the rest
    of the path still says where to look. A home path, a hostname the checker's own
    patterns know, or a launchd label in a name is how the operator finds the
    file to fix, and withholding it would hide every property list in a
    `launchd/` directory.

    Every character outside printable ASCII becomes `?`, so a name carrying a
    newline or a terminal escape cannot forge a line of the report.
    """
    patterns = [(p, label) for p, label in content_patterns() if label in CREDENTIAL]
    kinds = [label for pattern, label in patterns if pattern.search(text)]
    if emails(text):
        kinds.append(EMAIL)
    kinds += [label for pattern, label in private_name_patterns() + machine_name_patterns()
              if pattern.search(text)]
    if kinds:
        return f"<a name holding {', '.join(kinds)}>"
    return "".join(c if " " <= c <= "~" else "?" for c in text)


def scrubbed(message: str) -> str:
    """A message quoting a path, such as git's or tarfile's, with each match withheld.

    Error text names the entry it failed on, and that name comes from the
    repository being exported (security review, round 3). Matches are found
    across the whole message rather than word by word, because the private-key
    header carries spaces and never matched a single word (security review,
    round 4). A private person's name and a machine name are withheld here
    too, for the reason withheld() gives (security review of the machine
    names, round 2).
    """
    patterns = [(p, label) for p, label in content_patterns() if label in CREDENTIAL]
    patterns.append((EMAIL_PATTERN, EMAIL))
    patterns += private_name_patterns() + machine_name_patterns()
    for pattern, label in patterns:
        message = pattern.sub(f"<{label} withheld>", message)
    return "".join(c if " " <= c <= "~" else "?" for c in message)


def shown(rel: str) -> str:
    """`rel` with each segment passed through withheld()."""
    return "/".join(withheld(segment) for segment in rel.split("/"))


def content_patterns() -> list[tuple[re.Pattern[str], str]]:
    """The purity checker's patterns for the three categories, by label."""
    checker_path = REPO / "tools" / "check-payload-purity.py"
    if not checker_path.is_file():
        # A fork of the public tree has none, since the checker does not ship.
        # Exporting without one is refused rather than done unchecked.
        raise Refused(
            f"there is no purity check at {checker_path}, so nothing was built. The "
            f"content scan reads its patterns from it, and a fork that publishes adds one there"
        )
    checker = _checker(checker_path)
    # A LIST PER LABEL, NOT ONE PATTERN, because two FORBIDDEN entries can
    # share a label — the tailnet hostname and its split-fragment companion
    # both read "a tailnet hostname". Keeping only the last pattern
    # seen for a label would silently drop the other one from this scan
    # while check-payload-purity.py's own scan, which never groups by label,
    # kept applying both.
    by_label: dict[str, list[re.Pattern[str]]] = {}
    for entry in checker.FORBIDDEN:
        by_label.setdefault(entry[1], []).append(entry[0])
    wanted = PERSON + HOME + CREDENTIAL + MACHINE
    missing = [label for label in wanted if label not in by_label]
    if missing:
        raise Refused(
            f"the purity checker has no pattern labelled {', '.join(repr(m) for m in missing)}, "
            f"so the content scan would silently lose that category; nothing was built"
        )
    return [(pattern, label) for label in wanted for pattern in by_label[label]]


@functools.cache
def private_name_patterns() -> list[tuple[re.Pattern[str], str]]:
    """The names the purity checker cannot hold, from the operator's own file.

    REQUIRED, because this is the release gate: without the file the scan
    would know the operator's first name and nobody else's, and pass a tree
    naming them (see PRIVATE_NAMES_VARIABLE in the checker). Cached, because
    withheld() asks for it once per path segment; one run reads the file once.
    """
    checker = _checker(REPO / "tools" / "check-payload-purity.py")
    try:
        names = checker.private_names(required=True)
    except checker.PrivateNamesUnavailable as exc:
        raise Refused(f"{exc}, so nothing was built") from None
    return [(checker.private_names_pattern(names), PERSON[0])]


# **A MACHINE'S OWN NAME IS READ FROM THE OPERATOR'S FILE, LIKE A PERSON'S.**
# The checker's tailnet patterns catch a machine named inside a full tailnet
# hostname, and nothing caught the bare name, which an engine repository carried
# in comments, error messages, fixture keys and compound words. The names cannot
# be written here, since this file ships and the purity checker refuses them, so
# the operator lists them one per line, blank lines and `#` comments ignored, in
# a file named by MACHINE_NAMES_VARIABLE. It is a separate file from the private
# people's names because other tools read that one as a list of people, and the
# finding names a machine. A name matches in any case and INSIDE A LONGER WORD,
# so `<name>-builder` and `<Name>Config` are caught: a machine name is a coined
# word, and the occurrences found were compounds. Required, like the people's
# names: without the file the scan would pass a tree naming every machine.
MACHINE_NAME = "a machine's name"
MACHINE_NAMES_VARIABLE = "BUILDER_MACHINE_NAMES"


def machine_names() -> list[str]:
    """The names in the file MACHINE_NAMES_VARIABLE names; refuses without one."""
    named = os.environ.get(MACHINE_NAMES_VARIABLE, "")
    if not named:
        raise Refused(
            f"{MACHINE_NAMES_VARIABLE} is not set. It names the file, kept outside every "
            f"repository, that lists one per line the operator's machine names a published "
            f"tree must not carry, so nothing was built")
    path = Path(named).expanduser()
    try:
        # utf-8-sig, because a byte-order mark read as text would become part
        # of the first name, which would then match nothing.
        text = path.read_text(encoding="utf-8-sig")
    except (OSError, UnicodeDecodeError) as exc:
        raise Refused(
            f"{MACHINE_NAMES_VARIABLE} names {path}, which cannot be read "
            f"({exc.__class__.__name__}), so nothing was built") from None
    names = [line.strip() for line in text.splitlines()
             if line.strip() and not line.strip().startswith("#")]
    if not names:
        raise Refused(f"{path}, named by {MACHINE_NAMES_VARIABLE}, lists no name, so nothing was built")
    return names


@functools.cache
def machine_name_patterns() -> list[tuple[re.Pattern[str], str]]:
    """One pattern matching any machine name, in any case, inside a word or not.

    Cached, because withheld() asks for it once per path segment; one run reads
    the file once.
    """
    longest_first = sorted(machine_names(), key=len, reverse=True)
    pattern = re.compile("|".join(re.escape(n) for n in longest_first), re.IGNORECASE)
    return [(pattern, MACHINE_NAME)]


def export(name: str, root: Path, commit: str, into: Path) -> None:
    """The repository at `commit`, minus both exclusion lists, extracted into `into`."""
    pathspecs = ["."] + [f":(exclude){path}" for path in EXCLUDE[name]]
    pathspecs += [f":(exclude,literal){path}" for path in hashed_exclusions(name, root, commit)]
    with tempfile.TemporaryDirectory() as tmp:
        archive = Path(tmp) / "engine.tar"
        with open(archive, "wb") as handle:
            result = subprocess.run(
                ["git", "-C", str(root), "archive", commit, "--", *pathspecs],
                stdout=handle, stderr=subprocess.PIPE, check=False,
            )
        if result.returncode != 0:
            raise Refused(
                f"could not archive {name} at {commit}: "
                f"{scrubbed(result.stderr.decode(errors='replace').strip())}"
            )
        with tarfile.open(archive) as tar:
            members = tar.getmembers()
            for member in members:
                # git archive does not produce these, which is not a reason to
                # skip the check before writing anything.
                path = Path(member.name)
                if path.is_absolute() or ".." in path.parts:
                    raise Refused(f"refusing a tar entry that escapes the tree: {shown(member.name)}")
            try:
                tar.extractall(into, members=members, filter="data")
            except tarfile.TarError as exc:
                raise Refused(
                    f"refusing what {name} at {commit} would put in the tree: {scrubbed(str(exc))}"
                ) from exc


def walk(tree: Path) -> tuple[list[Path], list[Path]]:
    """Every regular file and every symlink in the tree, without following links."""
    files, links = [], []
    for dirpath, dirnames, filenames in os.walk(tree, followlinks=False):
        for entry in sorted(dirnames + filenames):
            path = Path(dirpath) / entry
            if path.is_symlink():
                links.append(path)
            elif path.is_file():
                files.append(path)
    return sorted(files), sorted(links)


def symlinks(tree: Path, links: list[Path]) -> list[str]:
    """Detector 1: a symlink anywhere. Its target is not printed, since it is content."""
    return [
        f"{shown(link.relative_to(tree).as_posix())}: a symlink, which ships as its target text"
        for link in links
    ]


def example_siblings(tree: Path, files: list[Path]) -> list[str]:
    """Detector 2: a real file exported beside the `.example` that stands in for it."""
    findings = []
    for path in files:
        if ".example" not in path.name:
            continue
        real = path.with_name(path.name.replace(".example", "", 1))
        if real.exists() or real.is_symlink():
            findings.append(
                f"{shown(real.relative_to(tree).as_posix())}: exported beside "
                f"{shown(path.name)}, which exists so that this file is not committed"
            )
    return findings


def fingerprint(value: str) -> str:
    """The sha256 of a matched value, which is what an ALLOW entry pins."""
    return hashlib.sha256(value.encode("utf-8", "surrogateescape")).hexdigest()


def allowed(allow: tuple[tuple[str, str, str, str], ...], rel: str, kind: str, value: str) -> bool:
    """Whether an entry accepts this exact value of this kind in this file."""
    digest = fingerprint(value)
    return any(path == rel and allowed_kind == kind and pinned == digest
               for path, allowed_kind, pinned, _ in allow)


# Every byte outside printable ASCII becomes a space before the scan, keeping
# newlines so line numbers hold. Decoded as latin-1, a byte such as 0xff is a
# letter to the regex engine, so a token stored right after one in a binary
# had no word boundary in front of it and went unseen; the planted binary in
# the tests is what showed it.
PRINTABLE = bytes(
    byte if byte in (9, 10, 13) or 32 <= byte < 127 else 32 for byte in range(256)
)

# An ANSI escape sequence blanked byte-for-byte, before PRINTABLE above turns
# the lone ESC into a single space. A CSI sequence's final byte is itself a
# letter (`m`, `J`, `K`, `H`, ...), so turning only the ESC into a space left
# that letter sitting against whatever followed it with no word boundary
# between them: a terminal capture of a prompt storing `\x1b[J<name>@<host>`
# read as `[J<name>@<host>`, and `\bname\b` cannot start on a `J`. Blanking
# the whole sequence, not only the ESC byte, is what restores the boundary,
# and spaces of the same length keep every later offset and line number
# where it was.
#
# **BLANKING CAN HIDE AS WELL AS REVEAL, SO IT ONLY EVER ADDS A READING.** No
# byte rule tells `ESC[J<name>`, where `J` ends the sequence, from a stray
# `ESC[<name>`, where the first letter of the name would be taken as the final
# byte and blanked; an OSC with a distant terminator would blank everything up
# to it. Both reviews of the first version showed a token the plain reading
# caught going missing. So content_scan matches the plain reading and the
# blanked one and reports the union, and a newline inside a sequence survives
# blanking so line numbers agree between the two.
#
# The union is kept once per path, line and label, because a finding never
# prints the value it matched: two tokens on one line would print two
# identical lines, and the person fixing them reads both on that line anyway.
# The allowlist is checked per matched value before this, so an allowed value
# cannot stand in for an unallowed one beside it.
ESCAPE_SEQUENCE = re.compile(
    rb"\x1b\[[0-?]*[ -/]*[@-~]"  # CSI: params, intermediates, one final byte.
    rb"|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)"  # OSC: up to BEL or ESC backslash.
    rb"|\x1b[^\[\]]"  # any other two-byte ESC sequence.
)


def _blanked(match: re.Match[bytes]) -> bytes:
    return bytes(byte if byte == 10 else 32 for byte in match.group())


def located(text: str, textual: bool, start: int) -> str:
    """The line of `start`, and its byte offset too when the file is not text."""
    line = text.count("\n", 0, start) + 1
    return f"{line}" if textual else f"{line} (byte {start})"


def content_scan(
    tree: Path, files: list[Path], patterns: list[tuple[re.Pattern[str], str]],
    allow: tuple[tuple[str, str, str, str], ...],
) -> tuple[list[str], list[str]]:
    """Detector 3: (findings, notices) — credentials, addresses and machine
    paths, by location and kind.

    Every file is read as latin-1, which decodes any byte, so a binary is
    scanned for the strings embedded in it rather than reported unscannable
    and waved through. Each path segment is scanned too, since the path ships.

    A file that is not valid UTF-8 text has its findings reported by byte
    offset as well as line, since "line" means little in a binary and the
    offset is what points a reader at the exact bytes.

    A hand-written page is scanned like any other; what would be a finding on
    it is kept as a notice instead, never a refusal — the scan still reports
    what it would have flagged.
    """
    findings: list[str] = []
    notices: list[str] = []
    for path in files:
        hand_written = payload.is_hand_written(path)
        rel = path.relative_to(tree).as_posix()
        where = shown(rel)
        for segment in rel.split("/"):
            for pattern, label in patterns:
                if any(not allowed(allow, rel, label, m.group(0)) for m in pattern.finditer(segment)):
                    if hand_written:
                        notices.append(payload.authorship_notice(f"{where} (its name)", label))
                    else:
                        findings.append(f"{where}: its name contains {label}")
            for _, domain, found in emails(segment):
                if not allowed(allow, rel, EMAIL, found):
                    category = f"{EMAIL} at {domain}"
                    if hand_written:
                        notices.append(payload.authorship_notice(f"{where} (its name)", category))
                    else:
                        findings.append(f"{where}: its name contains {category}")
        raw = path.read_bytes()
        try:
            raw.decode("utf-8")
            textual = True
        except UnicodeDecodeError:
            textual = False
        readings = (
            raw.translate(PRINTABLE).decode("latin-1"),
            ESCAPE_SEQUENCE.sub(_blanked, raw).translate(PRINTABLE).decode("latin-1"),
        )
        seen: set[str] = set()
        for text in readings:
            for pattern, label in patterns:
                for match in pattern.finditer(text):
                    if allowed(allow, rel, label, match.group(0)):
                        continue
                    place = f"{where}:{located(text, textual, match.start())}"
                    finding = f"{place}: {label}"
                    if finding not in seen:
                        seen.add(finding)
                        if hand_written:
                            notices.append(payload.authorship_notice(place, label))
                        else:
                            findings.append(finding)
            for start, domain, found in emails(text):
                if allowed(allow, rel, EMAIL, found):
                    continue
                place = f"{where}:{located(text, textual, start)}"
                category = f"{EMAIL} at {domain}"
                finding = f"{place}: {category}"
                if finding not in seen:
                    seen.add(finding)
                    if hand_written:
                        notices.append(payload.authorship_notice(place, category))
                    else:
                        findings.append(finding)
    return findings, notices


def emails(text: str) -> list[tuple[int, str, str]]:
    """(offset, domain, address) of every address in `text` that could name a person."""
    found = []
    for match in EMAIL_PATTERN.finditer(text):
        local, domain = match.group(1), match.group(2)
        if (EMAIL_DOMAIN_ALLOWED.fullmatch(domain) or EMAIL_LOCAL_ALLOWED.fullmatch(local)
                or EMAIL_DOMAIN_NOT_A_DOMAIN.fullmatch(domain)):
            continue
        found.append((match.start(), domain, match.group(0)))
    return found


def classify(value: object) -> str:
    """What a value is, in words that never include the value."""
    if value is BLOCK:
        return "inline value in a block below the key"
    if value is None or value == "":
        return "empty"
    if isinstance(value, (bool, int, float)):
        return "literal scalar"
    text = str(value).strip().strip("\"'")
    if text == "" or text.lower() in ("null", "none", "~"):
        return "empty"
    if text.lower() in ("true", "false", "yes", "no") or re.fullmatch(r"-?\d+(?:\.\d+)?", text):
        return "literal scalar"
    if ENV_REFERENCE.fullmatch(text):
        return "environment reference"
    return f"inline value of {len(text)} characters"


def walk_keys(data: object, trail: str = "", secret: bool = False) -> list[tuple[str, object]]:
    """Every (dotted key, value) under a secret-shaped key in parsed data.

    A list under a secret-shaped key has no key of its own per item, so its
    scalars are classified under the list's key.
    """
    found = []
    if isinstance(data, dict):
        for key, value in data.items():
            name = f"{trail}.{key}" if trail else str(key)
            if isinstance(value, (dict, list)):
                found += walk_keys(value, name, bool(SECRET_KEY.search(str(key))))
            elif SECRET_KEY.search(str(key)):
                found.append((name, value))
    elif isinstance(data, list):
        for index, value in enumerate(data):
            name = f"{trail}[{index}]"
            if isinstance(value, (dict, list)):
                found += walk_keys(value, name, secret)
            elif secret:
                found.append((name, value))
    return found


def line_keys(text: str) -> list[tuple[str, object]]:
    """The same, read line by line, for formats the standard library cannot parse."""
    found = []
    for lineno, line in enumerate(text.splitlines(), 1):
        if line.lstrip().startswith(("#", ";", "//")):
            continue
        match = KEY_LINE.match(line)
        if not match or not SECRET_KEY.search(match.group(1)):
            continue
        value = match.group(2)
        # A trailing comment is not part of the value. A quoted value ends at
        # its closing quote, so what follows it is dropped rather than counted
        # into the reported length (review, round 1).
        if value.startswith(("'", '"')):
            closing = value.find(value[0], 1)
            if closing != -1:
                value = value[: closing + 1]
        else:
            value = re.split(r"\s+#", value, maxsplit=1)[0]
        # An opening brace or bracket starts a nested block, which is walked
        # as its own lines rather than classified here.
        if value in ("{", "["):
            continue
        # A YAML block scalar carries its value on the lines below.
        if value in ("|", ">", "|-", ">-"):
            value = BLOCK
        found.append((f"{match.group(1)} (line {lineno})", value))
    return found


def is_config(path: Path) -> bool:
    return path.suffix.lower() in CONFIG_SUFFIXES or path.name.startswith(".env")


def classifier(
    tree: Path, files: list[Path], allow: tuple[tuple[str, str, str, str], ...],
) -> tuple[list[str], list[str]]:
    """Detector 4: (findings, report) for every secret-shaped key in a config file."""
    findings, report = [], []
    for path in files:
        if not is_config(path):
            continue
        rel = path.relative_to(tree).as_posix()
        text = path.read_bytes().decode("utf-8", errors="replace")
        keys = None
        try:
            if path.suffix.lower() == ".json":
                keys = walk_keys(json.loads(text))
            elif path.suffix.lower() == ".toml":
                keys = walk_keys(tomllib.loads(text))
        except (ValueError, tomllib.TOMLDecodeError):
            keys = None
        if keys is None:
            keys = line_keys(text)
        for key, value in keys:
            kind = classify(value)
            report.append(f"{shown(rel)}: {withheld(key)}: {kind}")
            if kind.startswith("inline value") and not allowed(allow, rel, INLINE, str(value)):
                findings.append(f"{shown(rel)}: {withheld(key)}: {kind}")
    return findings, report


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog=PROG, description="Build the public tree of one of Builder's engine repositories.",
    )
    parser.add_argument("name", choices=ENGINES, help="the repository to export")
    parser.add_argument("--version", required=True, help="release version, e.g. 0.6.0")
    parser.add_argument("--out", type=Path, required=True, help="directory to build into")
    parser.add_argument("--from", dest="source", type=Path, default=None,
                        help="the repository's checkout (default: beside this one's primary checkout)")
    parser.add_argument("--ref", default=payload.PUBLISHED_REF,
                        help=f"ref to export (default: {payload.PUBLISHED_REF})")
    parser.add_argument("--force", action="store_true",
                        help="replace a directory this tool built before")
    args = parser.parse_args(argv)

    # EVERYTHING CHECKABLE WITHOUT TOUCHING DISK IS CHECKED FIRST, so a refusal
    # leaves no partial tree.
    if not hasattr(tarfile, "data_filter"):
        raise Refused(
            f"this Python ({sys.version.split()[0]}) has no tarfile data filter, "
            f"which extraction relies on; run {PROG} with Python 3.11.4 or later"
        )
    # The version is written into release.json after every detector has run,
    # so it takes a release's identifiers rather than free text.
    if not re.fullmatch(r"\d+\.\d+\.\d+(?:-(?:alpha|beta|rc)(?:\.\d+)?)?", args.version):
        raise Refused(
            f"{args.version!r} is not a version of the form MAJOR.MINOR.PATCH, "
            f"optionally followed by -alpha, -beta or -rc and a number"
        )
    # A ref beginning with a dash would be read by git as an option.
    if args.ref.startswith("-"):
        raise Refused(f"{args.ref!r} is not a ref")

    allow = ALLOW[args.name]
    for path, kind, pinned, reason in allow:
        if not reason.strip():
            raise Refused(f"the allowance for {path} ({kind}) gives no reason")
        if not re.fullmatch(r"[0-9a-f]{64}", pinned):
            raise Refused(f"the allowance for {path} ({kind}) pins no sha256 fingerprint")
    for pinned, reason in EXCLUDE_HASHED[args.name]:
        if not reason.strip():
            raise Refused(f"the hashed exclusion {pinned[:12]} gives no reason")
        if not re.fullmatch(r"[0-9a-f]{64}", pinned):
            raise Refused(f"a hashed exclusion ({reason}) pins no sha256 fingerprint")
    patterns = content_patterns() + private_name_patterns() + machine_name_patterns()
    root =(args.source or payload.siblings_dir() / args.name).resolve()
    commit = payload.commit_of(root, args.ref)
    if commit is None:
        raise Refused(f"{args.ref} names no commit in {root}, so there is nothing to export")
    # The licence files are read at the exported commit, never the working
    # tree, and a missing or linked one is refused before anything is written.
    payload.licence_blobs(args.name, root, commit)

    out = args.out.resolve()
    if out.exists() and any(out.iterdir()):
        if not args.force:
            raise Refused(f"{out} is not empty; pass --force to replace it")
        # --force deletes an operator-supplied path, so it deletes only a
        # directory this tool built, which carries the marker.
        if not (out / BUILD_MARKER).is_file():
            raise Refused(
                f"{out} is not empty and was not built by {PROG}: it has no "
                f"{BUILD_MARKER}. Refusing to delete it."
            )
        shutil.rmtree(out)
    out.mkdir(parents=True, exist_ok=True)

    # Anything that fails after the tree exists takes the tree with it.
    try:
        export(args.name, root, commit, out)
        for filename in payload.LICENCE_FILES:
            placed = out / filename
            if placed.is_symlink() or not placed.is_file():
                raise Refused(
                    f"{filename} is not in the built tree as a regular file; an "
                    f"exclusion must not remove a licence file"
                )
        files, links = walk(out)
        classified, report = classifier(out, files, allow)
        content_findings, content_notices = content_scan(out, files, patterns, allow)
        detectors = (
            ("symlinks", symlinks(out, links)),
            (".example siblings", example_siblings(out, files)),
            ("content scan", content_findings),
            ("secret-shaped keys", classified),
        )
        found = [(title, items) for title, items in detectors if items]
        if found:
            lines = []
            for title, items in found:
                lines.append(f"{title} ({len(items)}):")
                lines += [f"  {item}" for item in items]
            raise Refused(
                f"{args.name} at {commit} cannot be exported as it stands. The tree "
                f"was DISCARDED. No value is printed; open each file to judge it.\n  "
                + "\n  ".join(lines)
            )
        # The manifest and marker are written inside the same cleanup, so a
        # failure here leaves no vetted-looking tree without them (review,
        # round 1).
        record = {
            "version": args.version,
            "built_at": datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "repositories": {args.name: commit},
            "files": {
                path.relative_to(out).as_posix(): hashlib.sha256(path.read_bytes()).hexdigest()
                for path in files
            },
        }
        (out / "release.json").write_text(json.dumps(record, indent=2) + "\n", encoding="utf-8")
        (out / BUILD_MARKER).write_text(
            f"Built by {PROG}. Its presence is what allows --force "
            f"to replace this directory; delete it and the tool will refuse.\n",
            encoding="utf-8",
        )
    except BaseException:
        # NO ignore_errors: a refusal here says the tree was DISCARDED, so a
        # removal that fails must fail loudly rather than leave what was found
        # on disk under that claim (security review of publish-payload's
        # multi-tree build, which runs this for every sibling).
        shutil.rmtree(out)
        raise

    print(f"{PROG}: built {len(files)} file(s) of {args.name} at {commit[:9]} for v{args.version} at {out}")
    print("  symlinks, .example siblings, content scan: nothing found")
    print(f"  secret-shaped keys: {len(report)} classified, none inline")
    for line in report:
        print(f"    {line}")
    if content_notices:
        print(f"  {len(content_notices)} notice(s) on a hand-written page, not refused:")
        for n in content_notices:
            print(f"    {n}")
    print(
        "\n  Nothing was pushed and no repository was created or made public. "
        "Publishing is a person's deliberate act, because content once fetched "
        "stays fetched."
    )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except Refused as exc:
        print(f"{PROG}: {exc}", file=sys.stderr)
        raise SystemExit(2) from exc
