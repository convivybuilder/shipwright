    "a GitHub token",
    "a GitHub fine-grained token",
    "an API key",
    "an AWS access key id",
    "an AWS temporary access key id",
    "a private key",
    "a Slack token",
    "a Slack app-level token",
    "a JSON Web Token",
    "a Stripe API key",
    "a Stripe webhook signing secret",
    "a Google API key",
    "a connection string with an embedded password",
)
MACHINE = (
    "a Tailscale address",
    "a Tailscale IPv6 address",
    "an IPv6 address in a globally routable or unique-local range",
    "a tailnet hostname",
    "a volume mounted only on this machine",
    "an install prefix specific to this machine",
    "a Windows UNC network path",
    "a launchd label outside the product's namespace",
)

EMAIL = "an email address"
# `git@host:` is git's SSH remote shorthand, not an address.
EMAIL_PATTERN = re.compile(r"\b(?!git@[A-Za-z0-9.-]+:)([A-Za-z0-9._%+-]+)@([A-Za-z0-9.-]+\.[A-Za-z]{2,})")
# Domains reserved for documentation and testing (RFC 2606), and the no-reply
# forms, name nobody. `.local` is NOT here: it names a machine on a network.
EMAIL_DOMAIN_ALLOWED = re.compile(
    r"(?:.*\.)?example\.(?:com|org|net)|.*\.(?:example|test|invalid)|users\.noreply\.github\.com",
    re.IGNORECASE,
)
EMAIL_LOCAL_ALLOWED = re.compile(r"no-?reply", re.IGNORECASE)
# Homebrew names a versioned formula's service file `homebrew.mxcl.<formula>@<version>.plist`,
# which reads as an address at the domain `<version>.plist`. No domain ends in `.plist`.
EMAIL_DOMAIN_NOT_A_DOMAIN = re.compile(r"\d+(?:\.\d+)*\.plist", re.IGNORECASE)

