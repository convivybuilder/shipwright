#!/usr/bin/env python3
"""Create the GitHub App a single-account install's agents act as, from a
manifest the operator confirms in the browser.

    bin/create-github-app [--org <name>] [--port <n>]   open the page this prints, confirm on GitHub
    bin/create-github-app --code <code>                 finish with the code from the address bar
    bin/create-github-app --read-only ...               the optional second App, read-only
    bin/create-github-app --if-missing                  do nothing when a key already exists
    bin/create-github-app --code-from-tty               also accept the whole redirect address
                                                         pasted at the terminal

**THE MANIFEST FIXES THE PERMISSIONS, AND THE OPERATOR ONLY CONFIRMS THEM.**
The App gets contents write, pull requests write, checks read, actions read
and metadata read, and never administration, so it cannot change the ruleset
that gates main. `--read-only` makes the second App, with contents and
metadata read alone, for repositories agents read and never write.

**HOW THE CODE COMES BACK.** This serves a page on 127.0.0.1 that posts the
manifest to GitHub. After the operator clicks Create, GitHub redirects the
browser to this listener with a one-time code and this run's own state, which
is exchanged for the App's id and private key. Over SSH, forward the port
first (`ssh -L <port>:127.0.0.1:<port> <host>`, with the same `--port` here).
When the redirect cannot reach the listener, the browser is left at the
address GitHub redirected it to even though the page never loaded: run again
with `--code <that code>`, the value after `code=` in that address, or run
with `--code-from-tty` and paste the whole address at the terminal when
prompted, since that still reads from this machine's own controlling terminal
even when the redirect cannot reach it.

**--if-missing MAKES THIS SAFE TO RUN FROM ANOTHER TOOL.** Builder's own
installer runs this at the end of a server install. When a key is already
there, `--if-missing` prints where it is and where to manage the App's
installations, and exits 0 without opening a listener or touching anything;
a fresh install still waits for the browser click as usual. The
installations address comes from the App's slug, stored beside its key when
it was created, so this never contacts GitHub to produce it; an App created
before this stored a slug falls back to naming where to find it on
github.com by hand.

**--code-from-tty OFFERS A SECOND WAY FOR THE CODE TO ARRIVE.** While the
listener waits for GitHub's redirect, this also reads lines from `/dev/tty`,
the terminal this is running in, piped install or not. Each line is read as
the whole address the browser was left at after the failed redirect —
`http://127.0.0.1:<port>/callback?code=...&state=...` — never a bare code: a
line that is not shaped like that address, or whose `state` does not match
this run's own, is refused with a message explaining why, and this keeps
waiting for another line. Whichever arrives first with a matching state —
the redirect, or a pasted address followed by enter — wins, and the other
stops. When `/dev/tty` cannot be opened, this falls back to waiting on the
redirect alone. Over SSH, with no port forwarded, the browser's redirect
cannot reach the listener, but the address bar still ends up holding that
address: copy the whole thing and paste it here.

**IT NEVER REPLACES A KEY.** The id and key are written to the `github-app`
directory under Builder's configuration directory, `~/.config/convivy`
(`github-app-read-only` for `--read-only`), the key at mode 600, and an
existing key there stops the run. The App's client and webhook secrets are
not stored: nothing on the install uses them.

Install the App on your repositories afterwards, at the address this prints.
"""

from __future__ import annotations

import argparse
import html
import http.server
import json
import os
import pathlib
import secrets
import select
import sys
import threading
import urllib.error
import urllib.parse
import urllib.request

PROG = "create-github-app"
API = "https://api.github.com"
WEB = "https://github.com"
WAIT_SECONDS = 600

PERMISSIONS = {
    "write": {"contents": "write", "pull_requests": "write", "checks": "read",
              "actions": "read", "metadata": "read"},
    "read-only": {"contents": "read", "metadata": "read"},
}
# A permission that would let the App change what gates main.
FORBIDDEN = ("administration",)


class Refused(Exception):
    """Something the operator has to decide about. Never a stack trace."""


def config_dir(read_only: bool) -> pathlib.Path:
    # Overridable so the tests run against a temporary directory.
    base = os.environ.get("BUILDER_CONFIG_DIR")
    root = pathlib.Path(base) if base else pathlib.Path.home() / ".config" / "convivy"
    return root / ("github-app-read-only" if read_only else "github-app")


def tty_path() -> str:
    # Overridable so the tests drive --code-from-tty with a pipe or pty of
    # their own, never the real /dev/tty.
    return os.environ.get("BUILDER_GITHUB_APP_TTY", "/dev/tty")


def manifest(kind: str, redirect: str, name: str) -> dict:
    return {
        "name": name,
        "url": WEB,
        "redirect_url": redirect,
        "public": False,
        "hook_attributes": {"url": WEB, "active": False},
        "default_permissions": dict(PERMISSIONS[kind]),
        "default_events": [],
    }


def create_url(org: str | None, state: str) -> str:
    where = f"/organizations/{urllib.parse.quote(org)}" if org else ""
    return f"{WEB}{where}/settings/apps/new?state={state}"


def form_page(action: str, body: dict) -> bytes:
    return f"""<!doctype html>
<meta charset="utf-8"><title>Create the Builder GitHub App</title>
<form method="post" action="{html.escape(action)}">
<p>This creates the GitHub App Builder's agents act as. GitHub shows its permissions next.</p>
<input type="hidden" name="manifest" value="{html.escape(json.dumps(body))}">
<button type="submit">Continue to GitHub</button>
</form>
""".encode()


# The code.

class Listener(http.server.ThreadingHTTPServer):
    page: bytes
    state: str
    code: str | None = None
    done: threading.Event
    # Guards the check-then-set of `code` and `done` below, since the HTTP
    # callback and the tty reader each run on their own thread and either
    # could arrive first: without this, both could pass "not done yet" and
    # the second to write `code` would silently overwrite the first's.
    lock: threading.Lock


class Handler(http.server.BaseHTTPRequestHandler):
    server: Listener

    def log_message(self, *args) -> None:
        pass

    def reply(self, status: int, body: bytes) -> None:
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self) -> None:
        url = urllib.parse.urlsplit(self.path)
        if url.path == "/":
            self.reply(200, self.server.page)
            return
        if url.path == "/callback":
            query = urllib.parse.parse_qs(url.query)
            code, state = query.get("code", [""])[0], query.get("state", [""])[0]
            if not code or not secrets.compare_digest(state, self.server.state):
                self.reply(400, b"This is not the redirect this run is waiting for.")
                return
            with self.server.lock:
                if not self.server.done.is_set():
                    self.server.code = code
                    self.server.done.set()
            self.reply(200, b"Done. Return to the terminal.")
            return
        self.reply(404, b"")


def _parse_pasted_address(line: str) -> tuple[str, str] | None:
    """(code, state) from a whole `http://127.0.0.1:<port>/callback?code=
    ...&state=...` address copied from the browser's address bar, or None
    when the line is not shaped like one."""
    parsed = urllib.parse.urlsplit(line)
    if not parsed.path.endswith("/callback") or not parsed.query:
        return None
    query = urllib.parse.parse_qs(parsed.query)
    code, state = query.get("code", [""])[0], query.get("state", [""])[0]
    if not code or not state:
        return None
    return code, state


def _read_code_from_tty(server: "Listener", fd: int) -> None:
    """Fill in `server.code` from a pasted address read off `fd`, polling so
    this stops as soon as the redirect wins instead of blocking forever on a
    terminal nobody is typing at. A line that is not the whole address GitHub
    redirected the browser to, or whose state does not match this run, is
    refused with a message and this keeps waiting for another line."""
    buf = b""
    try:
        while not server.done.is_set():
            ready, _, _ = select.select([fd], [], [], 0.2)
            if not ready:
                continue
            try:
                chunk = os.read(fd, 4096)
            except OSError:
                return
            if not chunk:
                return
            buf += chunk
            while b"\n" in buf:
                raw, buf = buf.split(b"\n", 1)
                text = raw.decode(errors="replace").strip()
                if not text or server.done.is_set():
                    continue
                parsed = _parse_pasted_address(text)
                if not parsed:
                    print(f"{PROG}: that is not the whole address. Paste the address the browser "
                          f"was left at after the failed redirect, the whole "
                          f"http://127.0.0.1:<port>/callback?code=...&state=... line.", flush=True)
                    continue
                code, state = parsed
                if not secrets.compare_digest(state, server.state):
                    print(f"{PROG}: that address's state does not match this run; paste the "
                          f"address this run's own browser page was redirected to.", flush=True)
                    continue
                with server.lock:
                    if not server.done.is_set():
                        server.code = code
                        server.done.set()
                return
    except OSError:
        return


def wait_for_code(kind: str, org: str | None, port: int, name: str,
                  wait: float = WAIT_SECONDS, ready=None, code_from_tty: bool = False) -> str:
    try:
        server = Listener(("127.0.0.1", port), Handler)
    except OSError as e:
        raise Refused(f"cannot listen on 127.0.0.1:{port} ({e.strerror}). Choose another "
                      f"--port, or finish with --code.")
    server.state = secrets.token_urlsafe(24)
    server.done = threading.Event()
    server.lock = threading.Lock()
    bound = server.server_address[1]
    redirect = f"http://127.0.0.1:{bound}/callback"
    server.page = form_page(create_url(org, server.state), manifest(kind, redirect, name))
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()

    tty_fd = None
    if code_from_tty:
        try:
            tty_fd = os.open(tty_path(), os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            tty_fd = None
    tty_thread = None
    if tty_fd is not None:
        tty_thread = threading.Thread(target=_read_code_from_tty, args=(server, tty_fd), daemon=True)
        tty_thread.start()

    try:
        print(f"Open http://127.0.0.1:{bound}/ in a browser on this machine, then create "
              f"the App on GitHub. Waiting up to {int(wait // 60)} minutes.", flush=True)
        if tty_fd is not None:
            print("Over SSH, the redirect will fail in your browser: copy the whole address it "
                  "was left at (http://127.0.0.1:<port>/callback?code=...&state=...) and paste "
                  "it here, then press enter.", flush=True)
        if ready:
            ready(bound)
        if not server.done.wait(wait):
            raise Refused("no redirect arrived. If GitHub showed an address with ?code= in "
                          "it, run again with --code <that code>.")
        return server.code
    finally:
        server.shutdown()
        server.server_close()
        if tty_thread is not None:
            tty_thread.join(1)
        if tty_fd is not None:
            try:
                os.close(tty_fd)
            except OSError:
                pass


def convert(code: str, opener=urllib.request.urlopen) -> dict:
    if not code or not all(c.isalnum() or c in "-_" for c in code):
        raise Refused("--code takes the value after ?code= in the address GitHub redirected to.")
    req = urllib.request.Request(f"{API}/app-manifests/{code}/conversions", method="POST",
                                 headers={"Accept": "application/vnd.github+json",
                                          "X-GitHub-Api-Version": "2022-11-28",
                                          "User-Agent": PROG})
    try:
        with opener(req, timeout=30) as resp:
            status, raw = resp.status, resp.read()
    except urllib.error.HTTPError as e:
        status, raw = e.code, e.read()
    except urllib.error.URLError as e:
        raise Refused(f"GitHub could not be reached ({e.reason}).")
    try:
        app = json.loads(raw or b"{}")
    except ValueError:
        app = {}
    if status != 201 or not isinstance(app, dict) or not app.get("id") or not app.get("pem"):
        said = app.get("message") if isinstance(app, dict) else None
        raise Refused(f"GitHub would not exchange the code ({status}): {said or 'no message'}. "
                      f"A code works once, within an hour.")
    return app


def permission_problem(app: dict, kind: str) -> str | None:
    granted = app.get("permissions") or {}
    bad = [p for p in FORBIDDEN if p in granted]
    if bad:
        return f"the App holds {', '.join(bad)}, which can change the ruleset that gates main"
    want = PERMISSIONS[kind]
    wrong = {p: granted.get(p) for p in want if granted.get(p) != want[p]}
    extra = sorted(set(granted) - set(want))
    if wrong or extra:
        return f"the App's permissions are {granted}, not {want}"
    return None


def store(app: dict, cfg: pathlib.Path) -> None:
    key = cfg / "app.pem"
    if os.path.lexists(key):
        raise Refused(f"{key} already exists, and this never replaces a key. Move it aside "
                      f"first if this App replaces that one.")
    cfg.mkdir(parents=True, exist_ok=True)
    os.chmod(cfg, 0o700)
    fd = os.open(key, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(app["pem"])
    (cfg / "app-id").write_text(f"{app['id']}\n")
    slug = app.get("slug")
    if slug:
        (cfg / "app-slug").write_text(f"{slug}\n")
    for stale in ("installation-id", "token.json"):
        try:
            (cfg / stale).unlink()
        except FileNotFoundError:
            pass


def manage_installations_line(cfg: pathlib.Path) -> str:
    """Where to install or manage the App's installations, read from what
    store() left on disk, never from GitHub: a stored slug gives the exact
    address; an App stored before this saved one falls back to naming where
    to find it on github.com by hand."""
    try:
        slug = (cfg / "app-slug").read_text().strip()
    except FileNotFoundError:
        slug = ""
    if slug:
        return f"Manage its installations at https://github.com/apps/{slug}/installations/new"
    return ("Manage its installations from github.com: Settings, then Developer settings, "
            "then GitHub Apps.")


def main(argv: list[str], opener=urllib.request.urlopen) -> int:
    parser = argparse.ArgumentParser(prog=PROG, description=__doc__.splitlines()[0])
    parser.add_argument("--org", help="create the App under this organisation "
                                      "(default: your own account)")
    parser.add_argument("--port", type=int, default=0,
                        help="the local port to listen on (default: any free one)")
    parser.add_argument("--code", help="finish with the code GitHub redirected to")
    parser.add_argument("--read-only", action="store_true",
                        help="create the second App, which reads and never writes")
    parser.add_argument("--name", help="the App's name on GitHub (must be unique there)")
    parser.add_argument("--if-missing", action="store_true",
                        help="when a key already exists, print where and exit 0, touching nothing")
    parser.add_argument("--code-from-tty", action="store_true",
                        help="while waiting for the redirect, also accept the whole redirect "
                             "address pasted at the terminal")
    args = parser.parse_args(argv)
    kind = "read-only" if args.read_only else "write"
    cfg = config_dir(args.read_only)
    key = cfg / "app.pem"
    name = args.name or ("Builder agents (read-only)" if args.read_only else "Builder agents")
    if args.if_missing and os.path.lexists(key):
        print(f"{PROG}: the App already exists; its id and key are in {cfg}.")
        print(manage_installations_line(cfg))
        return 0
    try:
        if os.path.lexists(key):
            raise Refused(f"{key} already exists, and this never replaces a key.")
        code = args.code or wait_for_code(kind, args.org, args.port, name,
                                          code_from_tty=args.code_from_tty)
        app = convert(code, opener)
        problem = permission_problem(app, kind)
        if problem:
            raise Refused(f"{problem}. Nothing was stored. Delete the App at "
                          f"{app.get('html_url', 'its settings page')} and run this again.")
        store(app, cfg)
    except Refused as exc:
        print(f"{PROG}: {exc}", file=sys.stderr)
        return 2
    print(f"Created {app.get('slug') or app['id']}; its id and key are in {cfg}.")
    print(f"Install it on the repositories Builder works in: "
          f"{app.get('html_url', WEB)}/installations/new")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
