#!/usr/bin/env python3
"""Create the service accounts Builder runs as, and prove they have the right shape.

    sudo bin/provision-accounts --shape two|three                 create what is missing
    sudo bin/provision-accounts --shape two|three --dry-run       say what would happen, change nothing
    sudo bin/provision-accounts --shape two|three --check         report only; exit 1 on any failing row
    sudo bin/provision-accounts --shape two|three --remove [--purge-homes]

**The operator names the shape, and this command never falls back.** `--shape
two` creates `agents` alone. `--shape three` creates one `agents`/`reviewers`
pair per entity the install's record names (`--install-json`, default
`/opt/builder/install.json`): a missing file or a missing `entities` key names
a single entity, and the pair for a single entity, whatever its name, is the
bare `agents` and `reviewers` every install used before entities existed; with
more than one, each entity's pair is `<entity>-agents`/`<entity>-reviewers`.
No run without `--shape` is accepted. Both shapes also create the Library's
own service account and Orient's (company decision 0025 point 5): a service
account with no login does not count toward an install's shape, so each is
created and removed alongside the shape's accounts without being one of them,
and counts toward no entity. The Library's name is `_library` on macOS, the
platform's own convention for a daemon account, and `library` on Linux, where
no such convention applies; Orient's is `_orient` and `orient` the same way.
Orient also gets the `orient-tunnel` group, holding only the operator (who
runs `cloudflared` on these shapes), and `/opt/builder/run/orient`, the
socket's directory, owned by Orient's account with group `orient-tunnel` and
mode 750, under a root-owned `/opt/builder/run`.

**Builder runs as `agents`, and on the three-account shape its reviews run as
`reviewers`.** None of an entity's accounts may hold anything of the
operator's, or of another entity's: no admin rights, no `staff` membership,
and a home no other account this command creates can read. The operator joins
every service account's group, which is how they read session output without
sudo, and each entity's agents account joins the group that macOS's Remote
Login admits, which is how the operator reaches its sessions over ssh.

**The Library's account is not a login service account, and gets none of that.** It owns
the Library's database, credentials and state directory, and nothing reaches
it but the Library's own network listener — never ssh, never sudo, never the
operator's own session. So it gets no shell, no password anyone knows, no
ssh group membership, and the operator never joins its group: joining it
would be exactly the filesystem access this account exists to deny. Its home
is mode 700, tighter than a login service account's 750.

**The isolation check runs before any grant that would let an agents account
in.** After the accounts and their homes exist, this command signs in as each
entity's agents account and tries to list every other created account's home,
the Library's included, and the operator's — across entities as well as
within one. A refusal is required before the operator is added to an
account's group or an agents account is admitted to the ssh group. When the
check fails, the run stops with a refusal that names the home that let the
reader in and its mode, and no account involved is left with a new group
membership or ssh access.

**An account of the wrong shape is refused, never corrected.** A primary group
of `staff`, an admin membership, or a home readable by others means something
else made that account, and changing it silently could break whatever did. The
refusal prints the command that fixes it. What this adds to an account that is
otherwise right, the operator's membership, the ssh membership and the hidden
flag, it adds and names in its report.

**Every check below runs again after a change**, and the run fails on any row
that reads like the failing state. Each membership row is asked of the
directory service rather than read from what this command did, because what
this command did is what is being checked.

**On macOS the accounts are not role accounts.** `sysadminctl -roleAccount`
requires a name starting with `_` and a user ID from 450 to 499, which its own
help text says. Every account here, the Library's own `_library` included,
takes an ID from 401 to 449 instead and is created without `-roleAccount`, and
the hidden flag keeps it off the login window — the leading underscore on
`_library` is the macOS naming convention for a daemon account, not a role
account's own marker.

Needs root, so the administrator password is asked once, by sudo.
"""

from __future__ import annotations

import argparse
import grp
import importlib.machinery
import importlib.util
import os
import pathlib
import pwd
import secrets
import shutil
import stat
import subprocess
import sys
from dataclasses import dataclass, field

HERE = pathlib.Path(__file__).resolve().parent


def _load_sibling(module_name: str, filename: str):
    loader = importlib.machinery.SourceFileLoader(module_name, str(HERE / filename))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(module_name, loader))
    sys.modules[module_name] = module
    loader.exec_module(module)
    return module


# Which entities this install names, and the account pair each gets: read in
# one place and reused by install-privileged and uninstall-builder too, so
# they cannot disagree about where the list comes from.
ae = _load_sibling("account_entities", "account_entities.py")

PROG = "provision-accounts"

SERVICE_ACCOUNTS = ("agents", "reviewers")
HOME_MODE = 0o750

# User and group IDs for a new macOS account. Below 500, so macOS treats it as
# a service account; below 450, because 450 to 499 is the role-account range.
MAC_ID_RANGE = range(401, 450)

SHAPE_NAMES = ("two", "three")


def accounts_for_shape(shape: str, entities: list[str]) -> tuple[str, ...]:
    """The accounts this shape creates.

    Shape two is always the bare `agents` account, entities or not. Shape
    three is one agents/reviewers pair per entity, collapsing to the bare
    `agents` and `reviewers` names every install used before entities
    existed when there is exactly one.
    """
    if shape == "two":
        return ("agents",)
    return tuple(name for pair in ae.account_pairs(entities) for name in pair)


def ssh_accounts(accounts: tuple[str, ...]) -> tuple[str, ...]:
    """Every account in `accounts` that is an agents-type account: the one
    this install reaches over ssh, one per entity on the three-account
    shape."""
    return tuple(name for name in accounts if name == "agents" or name.endswith("-agents"))

# THE NO-LOGIN SERVICE ACCOUNTS, company decision 0025 point 5: the Library's
# own, which owns its database, credentials and state directory, and
# Orient's, which owns its own.
# Nothing reaches either but its own account's network listener, so unlike
# `agents` and `reviewers` neither gets a shell, a known password, sudo, ssh
# access or the operator's own membership in its group. A service account
# with no login does not count toward an install's shape, so neither is ever
# returned by accounts_for_shape or added to SERVICE_ACCOUNTS: those two
# answer "which accounts does this shape count", and a no-login account
# answers no. Both exist on the same two shapes that have a second account at
# all (`LIBRARY_SHAPES`); the single-account install runs everything as the
# operator and creates neither, and neither counts toward any entity.
#
# A SESSIONS-ONLY HOST, NOT YET BUILT, RUNS NEITHER: it reaches a remote Keel
# instead of its own, so it has nothing for either account to own. When that
# role is built it should create neither, the same way the single-account
# shape does not.
#
# EACH NAME DIFFERS BY PLATFORM. `_library` and `_orient` on macOS, where a
# name starting with `_` is the convention for a daemon account; `library`
# and `orient` on Linux, where no such convention applies. Keyed by a name
# used only within this table, so a reader never hardcodes the one copy of
# the code that creates a no-login account for each new one that needs it.
LIBRARY_ACCOUNT_NAMES = {"macos": "_library", "linux": "library"}
ORIENT_ACCOUNT_NAMES = {"macos": "_orient", "linux": "orient"}
NO_LOGIN_ACCOUNTS = {"library": LIBRARY_ACCOUNT_NAMES, "orient": ORIENT_ACCOUNT_NAMES}
LIBRARY_SHAPES = ("two", "three")
# Tighter than HOME_MODE: nothing but the account itself reads this, where a
# login service account's home is group-readable so the operator can join
# that group. Shared by every no-login account in NO_LOGIN_ACCOUNTS.
LIBRARY_HOME_MODE = 0o700
# No shell Builder gives a login service account: a no-login account is
# reached over its own network listener, never by a login or an interactive
# `su`.
NO_LOGIN_SHELL = "/usr/bin/false"

# ORIENT'S TUNNEL GROUP AND SOCKET DIRECTORY. `cloudflared` forwards
# to a Unix socket at ORIENT_SOCKET_DIR so that no account but Orient's can
# bind the path or connect to it, except the account that runs `cloudflared`
# (the operator, on these shapes), which is why it alone joins
# ORIENT_TUNNEL_GROUP. RUN_ROOT is root-owned and holds that directory; a
# root-run deploy step not yet built makes another directory there.
ORIENT_TUNNEL_GROUP = "orient-tunnel"
RUN_ROOT = "/opt/builder/run"
RUN_ROOT_MODE = 0o755
ORIENT_SOCKET_DIR = f"{RUN_ROOT}/orient"
ORIENT_SOCKET_DIR_MODE = 0o750
ROOT_UID = 0
ROOT_GID = 0


def library_account_name(platform: str) -> str:
    """The Library's own account name on `platform`."""
    return LIBRARY_ACCOUNT_NAMES[platform]


def orient_account_name(platform: str) -> str:
    """Orient's own account name on `platform`."""
    return ORIENT_ACCOUNT_NAMES[platform]


def no_login_account_names(platform: str) -> set[str]:
    """Every no-login service account's real name on `platform`: never
    joined by the operator, never one of a shape's own accounts
    (`accounts_for_shape`), and always created with `create_service_account`."""
    return {names[platform] for names in NO_LOGIN_ACCOUNTS.values()}


def home_mode_for(name: str, platform: str) -> int:
    return LIBRARY_HOME_MODE if name in no_login_account_names(platform) else HOME_MODE


def accounts_for(shape: str, platform: str, entities: list[str]) -> tuple[str, ...]:
    """The accounts this command provisions or removes for `shape` on
    `platform` with `entities`: `accounts_for_shape(shape, entities)`, plus
    every no-login service account where this shape has one."""
    accounts = accounts_for_shape(shape, entities)
    if shape in LIBRARY_SHAPES:
        accounts = (*accounts, *(names[platform] for names in NO_LOGIN_ACCOUNTS.values()))
    return accounts


class Refused(Exception):
    """Something the operator has to decide about. Never a stack trace."""


@dataclass
class Account:
    name: str
    uid: int
    gid: int
    home: str


@dataclass
class Row:
    """One line of the verification table."""

    what: str
    ok: bool
    # What brings a failing row to the passing state, or "" when nothing here
    # can, and whether this command applies it itself.
    fix: str = ""
    addable: bool = False


@dataclass
class Report:
    rows: list[Row] = field(default_factory=list)

    def add(self, what: str, ok: bool, fix: str = "", addable: bool = False) -> None:
        self.rows.append(Row(what, ok, fix, addable))

    @property
    def wrong(self) -> list[Row]:
        return [r for r in self.rows if not r.ok and not r.addable]

    @property
    def to_add(self) -> list[Row]:
        return [r for r in self.rows if not r.ok and r.addable]


def add_dir_rows(report: Report, system: System, path: str, uid: int, gid: int,
                 mode: int, owned_by: str) -> None:
    """Rows for a directory this command owns outright, with no account of
    its own: it must exist as a plain directory, owned `uid:gid`, at exactly
    `mode`. Mirrors the home rows `inspect` adds for each account. An
    existing one of the wrong shape fails the same way an account of the
    wrong shape does: refused, never corrected."""
    st = system.home_stat(path)
    if st is None:
        report.add(f"{path} exists", False, "this command creates it", addable=True)
        return
    report.add(f"{path} is a directory", stat.S_ISDIR(st.st_mode),
               f"move aside whatever is at {path}")
    report.add(f"{path} is owned by {owned_by}",
               st.st_uid == uid and st.st_gid == gid,
               f"chown {owned_by} {path}")
    report.add(
        f"{path} reads {stat.filemode(stat.S_IFDIR | mode)} (it reads {stat.filemode(st.st_mode)})",
        stat.S_IMODE(st.st_mode) == mode,
        f"chmod {mode:o} {path}")


def user_record(name: str) -> str:
    """The account's record in the local directory node, as dscl names it.

    A directory-service path rather than a filesystem one: the home is
    whatever this record's NFSHomeDirectory says, read through `pwd`.
    """
    return f"/Users/{name}"


def run(argv: list[str], stdin: str = "") -> subprocess.CompletedProcess:
    """Run a command. Its standard input is `stdin`, never the terminal."""
    return subprocess.run(argv, input=stdin, capture_output=True, text=True, check=False)


class System:
    """The directory service and the account commands for one platform.

    Reads go through `pwd`, `grp` and `os.stat`, which ask the same directory
    service `dscl` and `getent` do. Tests replace this class.
    """

    platform = ""
    admin_groups: tuple[str, ...] = ()
    staff_group = "staff"
    ssh_group: str | None = None

    def __init__(self, runner=run):
        self.run = runner

    def account(self, name: str) -> Account | None:
        try:
            entry = pwd.getpwnam(name)
        except KeyError:
            return None
        return Account(name, entry.pw_uid, entry.pw_gid, entry.pw_dir)

    def group_name(self, gid: int) -> str | None:
        try:
            return grp.getgrgid(gid).gr_name
        except KeyError:
            return None

    def group_exists(self, name: str) -> bool:
        try:
            grp.getgrnam(name)
        except KeyError:
            return False
        return True

    def group_gid(self, name: str) -> int | None:
        try:
            return grp.getgrnam(name).gr_gid
        except KeyError:
            return None

    def group_members(self, name: str) -> set[str]:
        """Every account that holds `name`, by its own primary group or as
        a supplementary member. Asked of the directory service directly,
        the same one `group_exists` and `group_gid` ask, rather than
        assembled from what this command did."""
        try:
            group = grp.getgrnam(name)
        except KeyError:
            return set()
        return set(group.gr_mem) | {e.pw_name for e in pwd.getpwall() if e.pw_gid == group.gr_gid}

    def groups_of(self, user: str) -> set[str]:
        done = self.run(["/usr/bin/id", "-Gn", user])
        if done.returncode != 0:
            raise Refused(f"`id -Gn {user}` failed: {done.stderr.strip()}")
        return set(done.stdout.split())

    def is_member(self, user: str, group: str) -> bool:
        return group in self.groups_of(user)

    def home_stat(self, path: str) -> os.stat_result | None:
        try:
            return os.lstat(path)
        except FileNotFoundError:
            return None

    def home_is_empty(self, path: str) -> bool:
        try:
            return not os.listdir(path)
        except FileNotFoundError:
            return True

    def can_list(self, user: str, path: str) -> bool:
        """Whether `user` can list `path`, asked by running `ls` as that user.

        A refusal counts only when `ls` itself says "Permission denied". Any
        other failure means the probe did not run, a sudo that will not switch
        user for one, and reading that as a refusal would pass the isolation
        row on a machine where nothing was checked (security review).
        """
        # LC_ALL=C because sudo keeps the caller's locale by default, and `ls`
        # translates "Permission denied" into it.
        argv = ["/usr/bin/sudo", "-n", "-u", user, "/usr/bin/env", "LC_ALL=C", "/bin/ls", path]
        # A HOST WITH NO sudo AT ALL RAISES HERE, NOT A RETURN CODE. Left uncaught it
        # reached the operator as a traceback, and the isolation row was not
        # reported as the probe that did not run.
        try:
            done = self.run(argv)
        except OSError as exc:
            raise Refused(
                f"`{' '.join(argv)}` could not run ({exc.strerror}), so the isolation "
                f"check did not run. It needs sudo at /usr/bin/sudo."
            ) from exc
        if done.returncode == 0:
            return True
        if "Permission denied" in done.stderr:
            return False
        raise Refused(
            f"`{' '.join(argv)}` failed without `ls` refusing, so the isolation "
            f"check did not run: {(done.stderr or done.stdout).strip()[-400:]}"
        )

    def hidden(self, name: str) -> bool | None:
        """None where the platform has no such flag."""
        return None

    def refuses_empty_password(self, name: str) -> bool | None:
        """Whether logging in as `name` with an empty password fails.

        None where this command admits nobody to Remote Login.
        """
        return None

    def make_dir(self, path: str, uid: int, gid: int, mode: int) -> None:
        # Not a mkdir -p: the parent (an account's home root, or RUN_ROOT) is
        # not this command's to create.
        if self.home_stat(path) is None:
            os.mkdir(path, mode)
        # Owner and mode are set through a descriptor opened without following
        # a symlink. Set by path, a symlink planted where the directory goes
        # would hand its target to `uid` (security review).
        try:
            fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        except OSError:
            raise Refused(
                f"{path} is not a plain directory (a symlink or a file is "
                f"there). Move it aside and run this again."
            )
        try:
            os.fchown(fd, uid, gid)
            os.fchmod(fd, mode)
        finally:
            os.close(fd)

    def make_home(self, account: Account, mode: int = HOME_MODE) -> None:
        self.make_dir(account.home, account.uid, account.gid, mode)

    def remove_home(self, path: str) -> None:
        """Delete a removed account's home, never what a symlink points at."""
        st = self.home_stat(path)
        if st is None:
            return
        if stat.S_ISDIR(st.st_mode):
            shutil.rmtree(path)
        else:
            os.unlink(path)

    def check(self, done: subprocess.CompletedProcess, argv: list[str]) -> None:
        if done.returncode != 0:
            raise Refused(
                f"`{' '.join(argv)}` failed:\n{(done.stderr or done.stdout).strip()[-400:]}"
            )

    def call(self, argv: list[str], stdin: str = "") -> None:
        self.check(self.run(argv, stdin=stdin), argv)

    # Platform commands, overridden below.
    def create_account(self, name: str) -> None:
        raise NotImplementedError

    def create_service_account(self, name: str) -> None:
        """Create `name` as a no-login system account: no shell, no password
        anyone knows, no sudo. Unlike `create_account`, nothing here joins it
        to the ssh group or gives it a shell to join one with."""
        raise NotImplementedError

    def create_group(self, name: str) -> None:
        """Create `name` as a bare group, with no account of the same name."""
        raise NotImplementedError

    def remove_group(self, name: str) -> None:
        raise NotImplementedError

    def add_member(self, user: str, group: str) -> None:
        raise NotImplementedError

    def remove_member(self, user: str, group: str) -> None:
        raise NotImplementedError

    def hide(self, name: str) -> None:
        raise NotImplementedError

    def remove_account(self, name: str) -> None:
        raise NotImplementedError


class MacSystem(System):
    platform = "macos"
    admin_groups = ("admin", "wheel", "_developer")
    ssh_group = "com.apple.access_ssh"

    def is_member(self, user: str, group: str) -> bool:
        # dsmemberutil resolves nested groups, which `id -Gn` does not for
        # com.apple.access_ssh (it nests `admin`), so it answers the question
        # Remote Login asks.
        argv = ["/usr/bin/dsmemberutil", "checkmembership", "-U", user, "-G", group]
        done = self.run(argv)
        if "is not a member" in done.stdout:
            return False
        if "is a member" in done.stdout:
            return True
        raise Refused(f"`{' '.join(argv)}` gave no answer: {(done.stderr or done.stdout).strip()}")

    def hidden(self, name: str) -> bool | None:
        done = self.run(["/usr/bin/dscl", ".", "-read", user_record(name), "IsHidden"])
        return done.returncode == 0 and done.stdout.split()[-1:] in (["1"], ["YES"])

    def refuses_empty_password(self, name: str) -> bool | None:
        # Asked of the directory service, because whether sshd's
        # keyboard-interactive login through PAM honours PermitEmptyPasswords
        # has not been measured. dscl gives eDSAuthFailed for a nonexistent
        # user too, so this is only asked of an account that exists.
        argv = ["/usr/bin/dscl", ".", "-authonly", name, ""]
        done = self.run(argv)
        if done.returncode == 0:
            return False
        if "eDSAuthFailed" in done.stdout + done.stderr:
            return True
        raise Refused(
            f"`dscl . -authonly {name} ''` failed without refusing the password, so "
            f"whether {name} accepts an empty one is unknown: "
            f"{(done.stderr or done.stdout).strip()[-400:]}"
        )

    def free_id(self) -> int:
        used_uids = {e.pw_uid for e in pwd.getpwall()}
        used_gids = {e.gr_gid for e in grp.getgrall()}
        for candidate in MAC_ID_RANGE:
            if candidate not in used_uids and candidate not in used_gids:
                return candidate
        raise Refused(
            f"every ID from {MAC_ID_RANGE.start} to {MAC_ID_RANGE.stop - 1} is taken "
            f"by a user or a group, so there is none to give a new account. Nothing "
            f"was created."
        )

    def create_account(self, name: str) -> None:
        ident = self.free_id()
        # The group first, so the account is created with it as its primary
        # group rather than with `staff`.
        self.call(["/usr/sbin/dseditgroup", "-o", "create", "-i", str(ident), name])
        # The password goes in on standard input through `-password -`. On a
        # command line, `ps` would show it to every local user, and while
        # agents still run as the operator one could `su` into the account.
        # Created with none and given one afterwards, the account would accept
        # an empty password for that window (security review, both). It is
        # reached by ssh key or through sudo, so nobody needs to know it.
        # sysadminctl prompts with getpass on a terminal and reads a line of
        # standard input without one, which is what run() always gives it.
        self.call([
            "/usr/sbin/sysadminctl", "-addUser", name,
            "-fullName", f"Builder {name}",
            "-UID", str(ident), "-GID", str(ident),
            "-password", "-",
        ], stdin=f"{secrets.token_urlsafe(32)}\n")
        self.close_empty_password(name)

    def create_service_account(self, name: str) -> None:
        # Shares the pool `create_account` draws from (`free_id`, the same ID
        # range), but gets NO_LOGIN_SHELL rather than a shell to ssh in with.
        # The password is still a random one nobody is told, the same reason
        # `create_account` gives: created with none, the account would accept
        # an empty password for that window.
        ident = self.free_id()
        self.call(["/usr/sbin/dseditgroup", "-o", "create", "-i", str(ident), name])
        self.call([
            "/usr/sbin/sysadminctl", "-addUser", name,
            "-fullName", f"Builder {name}",
            "-UID", str(ident), "-GID", str(ident),
            "-shell", NO_LOGIN_SHELL,
            "-password", "-",
        ], stdin=f"{secrets.token_urlsafe(32)}\n")
        self.close_empty_password(name)

    def close_empty_password(self, name: str) -> None:
        """Leave `name` refusing an empty password, with none on a command line.

        sysadminctl reading its password from standard input is inferred
        from what it imports rather than documented, so the directory
        service is asked rather than assumed.
        """
        if self.refuses_empty_password(name):
            return
        # dscl's interactive mode reads its commands from standard input,
        # which `ps` does not show. Its exit status is not what is trusted:
        # the directory service is asked again.
        self.run(["/usr/bin/dscl", "."],
                 stdin=f"passwd {user_record(name)} {secrets.token_urlsafe(32)}\nquit\n")
        if not self.refuses_empty_password(name):
            raise Refused(
                f"{name} was created accepting an empty password, and setting one "
                f"did not take. Run: sudo passwd {name} (it prompts), then run this again."
            )

    def create_group(self, name: str) -> None:
        ident = self.free_id()
        self.call(["/usr/sbin/dseditgroup", "-o", "create", "-i", str(ident), name])

    def remove_group(self, name: str) -> None:
        self.call(["/usr/sbin/dseditgroup", "-o", "delete", name])

    def add_member(self, user: str, group: str) -> None:
        self.call(["/usr/sbin/dseditgroup", "-o", "edit", "-a", user, "-t", "user", group])

    def remove_member(self, user: str, group: str) -> None:
        self.call(["/usr/sbin/dseditgroup", "-o", "edit", "-d", user, "-t", "user", group])

    def hide(self, name: str) -> None:
        self.call(["/usr/bin/dscl", ".", "-create", user_record(name), "IsHidden", "1"])

    def remove_account(self, name: str) -> None:
        self.call(["/usr/sbin/sysadminctl", "-deleteUser", name])
        if self.group_exists(name):
            self.remove_group(name)


class LinuxSystem(System):
    platform = "linux"
    admin_groups = ("sudo", "wheel", "admin")

    def create_account(self, name: str) -> None:
        self.call([
            "/usr/sbin/useradd", "--system", "--create-home", "--user-group",
            "--shell", "/bin/bash", name,
        ])

    def create_service_account(self, name: str) -> None:
        # useradd with no `-p` leaves the password locked in /etc/shadow, so
        # no password is set at all rather than merely an unknown one.
        self.call([
            "/usr/sbin/useradd", "--system", "--create-home", "--user-group",
            "--shell", NO_LOGIN_SHELL, name,
        ])

    def create_group(self, name: str) -> None:
        self.call(["/usr/sbin/groupadd", "--system", name])

    def remove_group(self, name: str) -> None:
        self.call(["/usr/sbin/groupdel", name])

    def add_member(self, user: str, group: str) -> None:
        self.call(["/usr/sbin/usermod", "-aG", group, user])

    def remove_member(self, user: str, group: str) -> None:
        self.call(["/usr/bin/gpasswd", "-d", user, group])

    def remove_account(self, name: str) -> None:
        self.call(["/usr/sbin/userdel", "--remove", name])
        if self.group_exists(name):
            self.remove_group(name)


def system_for_platform() -> System:
    if sys.platform == "darwin":
        return MacSystem()
    if sys.platform.startswith("linux"):
        return LinuxSystem()
    raise Refused(f"{sys.platform} is neither macos nor linux. Nothing was changed.")


def inspect(system: System, operator: str, shape: str,
           entities: tuple[str, ...] = ("default",)) -> tuple[Report, list[str]]:
    """The verification table, and the accounts that do not exist yet.

    Computed before anything changes, so `--dry-run`, `--check` and the real
    run answer the same question and a refusal names every problem at once.
    `entities` names the three-account shape's entities; it is ignored on
    shape two.
    """
    accounts = accounts_for(shape, system.platform, list(entities))
    no_login_names = no_login_account_names(system.platform)
    ssh_names = ssh_accounts(accounts)
    report = Report()
    missing: list[str] = []
    present: dict[str, Account] = {}

    for name in accounts:
        account = system.account(name)
        if account is None:
            report.add(f"{name} exists", False, "this command creates it", addable=True)
            missing.append(name)
            continue
        present[name] = account
        report.add(f"{name} exists", True)

        primary = system.group_name(account.gid)
        report.add(
            f"{name}'s primary group is {name} (it is {primary})",
            primary == name,
            f"make {name}'s primary group a group named {name} (on macOS: "
            f"dseditgroup -o create {name}, then dscl . -create {user_record(name)} "
            f"PrimaryGroupID <its gid>)",
        )
        groups = system.groups_of(name)
        report.add(
            f"{name} is not in {system.staff_group}",
            system.staff_group not in groups,
            f"remove {name} from {system.staff_group}",
        )
        for admin in system.admin_groups:
            if not system.group_exists(admin):
                continue
            member = system.is_member(name, admin)
            report.add(f"{name} is not a member of {admin}", not member,
                       f"remove {name} from {admin}")

        st = system.home_stat(account.home)
        if st is None:
            report.add(f"{name}'s home {account.home} exists", False,
                       "this command creates it", addable=True)
        else:
            mode = stat.S_IMODE(st.st_mode)
            wanted_mode = home_mode_for(name, system.platform)
            report.add(
                f"{name}'s home {account.home} is a directory",
                stat.S_ISDIR(st.st_mode),
                f"move aside whatever is at {account.home}",
            )
            report.add(
                f"{name}'s home is owned by {name}:{name}",
                st.st_uid == account.uid and st.st_gid == account.gid,
                f"chown {name}:{name} {account.home}",
            )
            report.add(
                f"{name}'s home reads {stat.filemode(stat.S_IFDIR | wanted_mode)} "
                f"(it reads {stat.filemode(st.st_mode)})",
                mode == wanted_mode,
                f"chmod {wanted_mode:o} {account.home}",
            )

        # THE OPERATOR NEVER JOINS A NO-LOGIN ACCOUNT'S GROUP. Agents and
        # reviewers give the operator their group so session output can be
        # read without sudo; the Library and Orient are each reached over
        # their own network listener alone, and joining either's group would
        # be exactly the filesystem access company decision 0025 point 5
        # creates these accounts to deny.
        if name not in no_login_names and system.group_exists(name):
            report.add(
                f"{operator} is a member of {name}",
                system.is_member(operator, name),
                "this command adds it", addable=True,
            )

        hidden = system.hidden(name)
        if hidden is not None:
            report.add(f"{name} is hidden", hidden, "this command sets it", addable=True)

        if name in ssh_names:
            refuses = system.refuses_empty_password(name)
            if refuses is not None:
                report.add(f"{name} refuses an empty password", refuses,
                           f"sudo passwd {name} (it prompts), then run this again")

    # Orient's tunnel group and the socket's directory, on the same shapes as
    # Orient's own account (LIBRARY_SHAPES): neither is an account, so
    # neither is in `accounts`.
    if shape in LIBRARY_SHAPES:
        if not system.group_exists(ORIENT_TUNNEL_GROUP):
            report.add(f"{ORIENT_TUNNEL_GROUP} exists", False,
                       "this command creates it", addable=True)
        else:
            report.add(f"{ORIENT_TUNNEL_GROUP} exists", True)
            report.add(
                f"{operator} is a member of {ORIENT_TUNNEL_GROUP}",
                system.is_member(operator, ORIENT_TUNNEL_GROUP),
                "this command adds it", addable=True,
            )
            # THE GROUP IS THE SOCKET'S ACCESS BOUNDARY (the spec: "The group
            # orient-tunnel holds only the account that runs cloudflared"), so
            # an existing group that holds anyone else is the wrong shape,
            # refused rather than corrected, the same as every account here.
            extra = sorted(system.group_members(ORIENT_TUNNEL_GROUP) - {operator})
            report.add(
                f"{ORIENT_TUNNEL_GROUP} holds only {operator}"
                + (f" (it also holds {', '.join(extra)})" if extra else ""),
                not extra,
                f"remove {', '.join(extra)} from {ORIENT_TUNNEL_GROUP}",
            )
        add_dir_rows(report, system, RUN_ROOT, ROOT_UID, ROOT_GID, RUN_ROOT_MODE, "root:root")
        orient_name = orient_account_name(system.platform)
        orient_account = present.get(orient_name)
        tunnel_gid = system.group_gid(ORIENT_TUNNEL_GROUP)
        if orient_account is not None and tunnel_gid is not None:
            add_dir_rows(report, system, ORIENT_SOCKET_DIR, orient_account.uid, tunnel_gid,
                        ORIENT_SOCKET_DIR_MODE, f"{orient_name}:{ORIENT_TUNNEL_GROUP}")
        elif system.home_stat(ORIENT_SOCKET_DIR) is not None:
            # A directory already sits there and neither the orient account
            # nor orient-tunnel exists yet to verify it against (a leftover
            # from an earlier run, or one made by hand). Refused, never
            # corrected, rather than left unverified until both exist.
            report.add(
                f"{ORIENT_SOCKET_DIR} exists before {orient_name} and "
                f"{ORIENT_TUNNEL_GROUP} are both ready to own it",
                False,
                f"move aside whatever is at {ORIENT_SOCKET_DIR}, then run this again",
            )

    if system.ssh_group is not None:
        if not system.group_exists(system.ssh_group):
            raise Refused(
                f"there is no {system.ssh_group} group, so Remote Login is either "
                f"off or open to every user, and either way it cannot admit "
                f"only {', '.join(ssh_names)}. In System Settings, General, Sharing, "
                f"turn Remote Login on with access for \"Only these users\", then run "
                f"this again. Nothing was changed."
            )
        for name, account in present.items():
            member = system.is_member(name, system.ssh_group)
            if name in ssh_names:
                report.add(f"{name} is a member of {system.ssh_group}", member,
                           "this command adds it", addable=True)
            else:
                report.add(f"{name} is not a member of {system.ssh_group}", not member,
                           f"dseditgroup -o edit -d {name} -t user {system.ssh_group}")

    # Isolation, asked by running `ls` as the account, so the row is about what
    # the account can do rather than what the modes say it should. Run once per
    # agents-type account present, against every other created account's home
    # and the operator's — across entities as well as within one. Orient's
    # socket directory gets the same live probe once it exists, rather than
    # resting on its static mode bits alone, which is what the home rows
    # above already distrust on macOS (security review).
    operator_account = system.account(operator)
    socket_dir_exists = shape in LIBRARY_SHAPES and system.home_stat(ORIENT_SOCKET_DIR) is not None
    for ssh_name in ssh_names:
        if ssh_name not in present:
            continue
        others = [(n, a.home) for n, a in present.items() if n != ssh_name]
        if operator_account is not None:
            others.append((operator, operator_account.home))
        for other, path in others:
            if system.home_stat(path) is None:
                continue
            report.add(
                f"as {ssh_name}, listing {other}'s home is refused",
                not system.can_list(ssh_name, path),
                f"{other}'s home {path} lets {ssh_name} in; nothing here changes "
                f"another account's home",
            )
        if socket_dir_exists:
            report.add(
                f"as {ssh_name}, listing {ORIENT_SOCKET_DIR} is refused",
                not system.can_list(ssh_name, ORIENT_SOCKET_DIR),
                f"the orient socket directory {ORIENT_SOCKET_DIR} lets {ssh_name} in; "
                f"nothing here changes it",
            )

    return report, missing


def controls(system: System, operator: str, ssh_names: tuple[str, ...] = ("agents",)) -> Report:
    """Rows that must pass on any machine, so a failing check is believed.

    Each asks the same question as a row above, of a case whose answer is
    known. If the membership query or the `ls` probe were broken, these would
    fail with it rather than letting every service-account row read as passing.
    `ssh_names` is every agents-type account this shape's run created.
    """
    report = Report()
    operator_account = system.account(operator)
    primary = system.group_name(operator_account.gid) if operator_account else None
    if primary is not None:
        report.add(f"control: {operator} is a member of {primary}",
                   system.is_member(operator, primary))
    # The plan's own control on macOS, where the operator is an administrator.
    if system.platform == "macos":
        report.add(f"control: {operator} is a member of admin",
                   system.is_member(operator, "admin"))
    if operator_account is not None:
        report.add(f"control: as {operator}, listing {operator}'s home succeeds",
                   system.can_list(operator, operator_account.home))
    for ssh_name in ssh_names:
        agents = system.account(ssh_name)
        if agents is not None and system.home_stat(agents.home) is not None:
            # The same sudo path the isolation rows use, with an answer known to
            # be yes, so a refusal there is the home's mode and not the probe.
            report.add(f"control: as {ssh_name}, listing {ssh_name}'s home succeeds",
                       system.can_list(ssh_name, agents.home))
            report.add(f"control: as {operator}, listing {ssh_name}'s home succeeds "
                       f"through the group",
                       system.can_list(operator, agents.home))
    return report


def print_table(title: str, *reports: Report) -> None:
    print(title)
    for report in reports:
        for row in report.rows:
            mark = "ok" if row.ok else ("add" if row.addable else "WRONG")
            print(f"  {mark:<6} {row.what}")


def refuse_wrong(report: Report) -> None:
    if report.wrong:
        lines = "\n".join(f"  {r.what}\n    fix: {r.fix}" for r in report.wrong)
        raise Refused(
            f"an existing account has the wrong shape, and this command does not "
            f"change an account it did not make:\n{lines}\nNothing was changed."
        )


def isolation_failure(system: System, operator: str,
                      accounts: tuple[str, ...]) -> tuple[str, str, str, str] | None:
    """The reading account, the other account, its home path and its mode,
    for the first created agents-type account that can list another created
    account's home or the operator's — across entities as well as within
    one. None when every such pair refuses."""
    operator_account = system.account(operator)
    homes = [(name, system.account(name).home) for name in accounts if system.account(name)]
    if operator_account is not None:
        homes.append((operator, operator_account.home))
    for reader in ssh_accounts(accounts):
        for other, path in homes:
            if other == reader or system.home_stat(path) is None:
                continue
            if system.can_list(reader, path):
                st = system.home_stat(path)
                mode = stat.filemode(st.st_mode) if st else "unknown"
                return reader, other, path, mode
    return None


def provision(system: System, operator: str, shape: str,
              entities: tuple[str, ...] = ("default",)) -> list[str]:
    """Create what is missing and add what is addable. Returns what changed."""
    accounts = accounts_for(shape, system.platform, list(entities))
    no_login_names = no_login_account_names(system.platform)
    report, missing = inspect(system, operator, shape, entities)
    refuse_wrong(report)

    if shape == "two" and system.account("reviewers") is not None:
        raise Refused(
            "a `reviewers` account exists, so this machine already has the "
            "three-account shape. Use --shape three, or remove it first. "
            "Nothing was changed."
        )

    changed: list[str] = []

    # Step 1: the account, its own primary group, a home, and the hidden flag.
    # Every no-login account gets create_service_account and a tighter home
    # mode; every other account in this shape is a login service account.
    for name in accounts:
        if name in missing:
            if name in no_login_names:
                system.create_service_account(name)
            else:
                system.create_account(name)
            changed.append(f"created {name}")
        account = system.account(name)
        if account is None:
            raise Refused(f"{name} was created and the directory service does not have it.")
        st = system.home_stat(account.home)
        if name in missing or st is None:
            mode = home_mode_for(name, system.platform)
            system.make_home(account, mode=mode)
            changed.append(f"set {name}'s home {account.home} to {stat.filemode(stat.S_IFDIR | mode)}")
        if system.hidden(name) is False:
            system.hide(name)
            changed.append(f"hid {name}")

    # Step 2: the isolation check, before any grant that would let an agents
    # account in.
    failure = isolation_failure(system, operator, accounts)
    if failure is not None:
        reader, other, path, mode = failure
        subject = "the operator's home" if other == operator else f"{other}'s home"
        raise Refused(
            f"the isolation check failed: signed in as {reader}, listing {path} "
            f"succeeded (mode {mode}). {subject} must be unreadable to {reader} "
            f"before the operator joins its group or {reader} gains ssh access. "
            f"Nothing was changed."
        )

    # Step 3: the operator added to each account's group, every no-login
    # account excepted — see the matching row in inspect().
    for name in accounts:
        if name in no_login_names:
            continue
        if not system.is_member(operator, name):
            system.add_member(operator, name)
            changed.append(f"added {operator} to {name}")

    # Step 4: ssh group membership, one agents-type account at a time, only
    # after an empty password is refused.
    if system.ssh_group is not None:
        for ssh_name in ssh_accounts(accounts):
            if system.is_member(ssh_name, system.ssh_group):
                continue
            if system.refuses_empty_password(ssh_name) is False:
                raise Refused(
                    f"{ssh_name} accepts an empty password, so it is not added to "
                    f"{system.ssh_group}. Run: sudo passwd {ssh_name} (it prompts), "
                    f"then run this again."
                )
            system.add_member(ssh_name, system.ssh_group)
            changed.append(f"added {ssh_name} to {system.ssh_group}")

    # Step 5: Orient's tunnel group, holding only the operator (who runs
    # cloudflared on these shapes), and the socket's directory, on the same
    # shapes Orient's own account is (LIBRARY_SHAPES). Neither is an account,
    # so neither goes through steps 1 to 4.
    if shape in LIBRARY_SHAPES:
        if not system.group_exists(ORIENT_TUNNEL_GROUP):
            system.create_group(ORIENT_TUNNEL_GROUP)
            changed.append(f"created the {ORIENT_TUNNEL_GROUP} group")
        if not system.is_member(operator, ORIENT_TUNNEL_GROUP):
            system.add_member(operator, ORIENT_TUNNEL_GROUP)
            changed.append(f"added {operator} to {ORIENT_TUNNEL_GROUP}")
        if system.home_stat(RUN_ROOT) is None:
            system.make_dir(RUN_ROOT, ROOT_UID, ROOT_GID, RUN_ROOT_MODE)
            changed.append(f"created {RUN_ROOT}")
        orient_account = system.account(orient_account_name(system.platform))
        if orient_account is not None and system.home_stat(ORIENT_SOCKET_DIR) is None:
            tunnel_gid = system.group_gid(ORIENT_TUNNEL_GROUP)
            system.make_dir(ORIENT_SOCKET_DIR, orient_account.uid, tunnel_gid, ORIENT_SOCKET_DIR_MODE)
            changed.append(f"created {ORIENT_SOCKET_DIR}")

    return changed


def remove(system: System, shape: str, purge_homes: bool,
          entities: tuple[str, ...] = ("default",)) -> list[str]:
    accounts = accounts_for(shape, system.platform, list(entities))
    changed: list[str] = []
    present = [n for n in accounts if system.account(n) is not None]
    # A home the account does not own is not this command's to delete: an
    # account of that name whose home points at the shared folder or the
    # operator's home would otherwise have that path deleted as root
    # (security review). Asked of every home before anything is removed.
    foreign = []
    for name in present:
        account = system.account(name)
        st = system.home_stat(account.home)
        if st is not None and st.st_uid != account.uid:
            foreign.append(f"{account.home} (home of {name}, owned by uid {st.st_uid})")
    # Orient's socket directory gets the same test, since --remove deletes
    # it as root too: one Orient's account does not own, or one left with no
    # Orient account to own it, is not this command's to delete.
    if shape in LIBRARY_SHAPES:
        st = system.home_stat(ORIENT_SOCKET_DIR)
        orient = system.account(orient_account_name(system.platform))
        if st is not None and (orient is None or st.st_uid != orient.uid):
            foreign.append(f"{ORIENT_SOCKET_DIR} (Orient's socket directory, owned by uid "
                           f"{st.st_uid})")
    if foreign:
        raise Refused(
            f"these homes are not owned by their accounts, so something else made "
            f"them and this command does not delete them: {', '.join(foreign)}. "
            f"Point each account at its own home, or remove it by hand. Nothing "
            f"was removed."
        )
    full = [n for n in present if not system.home_is_empty(system.account(n).home)]
    orient_dir_full = (shape in LIBRARY_SHAPES and system.home_stat(ORIENT_SOCKET_DIR) is not None
                      and not system.home_is_empty(ORIENT_SOCKET_DIR))
    if (full or orient_dir_full) and not purge_homes:
        not_empty = [system.account(n).home for n in full] + ([ORIENT_SOCKET_DIR] if orient_dir_full else [])
        raise Refused(
            f"these homes are not empty: "
            f"{', '.join(not_empty)}. Pass --purge-homes "
            f"to delete them with their accounts. Nothing was removed."
        )
    for name in present:
        home = system.account(name).home
        if system.ssh_group and system.group_exists(system.ssh_group) \
                and system.is_member(name, system.ssh_group):
            system.remove_member(name, system.ssh_group)
        system.remove_account(name)
        # Deleted here rather than left to the platform's command, whose
        # default is not the same on every platform, so --purge-homes means
        # the home is gone and a later provision starts from nothing.
        system.remove_home(home)
        changed.append(f"removed {name} and its home {home}")

    # Orient's tunnel group and socket directory, removed alongside its
    # account. RUN_ROOT itself is left: a root-owned directory other steps
    # not yet built also use.
    if shape in LIBRARY_SHAPES:
        if system.home_stat(ORIENT_SOCKET_DIR) is not None:
            system.remove_home(ORIENT_SOCKET_DIR)
            changed.append(f"removed {ORIENT_SOCKET_DIR}")
        if system.group_exists(ORIENT_TUNNEL_GROUP):
            system.remove_group(ORIENT_TUNNEL_GROUP)
            changed.append(f"removed the {ORIENT_TUNNEL_GROUP} group")
    return changed


def resolve_operator(given: str | None, service_accounts: tuple[str, ...] = SERVICE_ACCOUNTS) -> str:
    operator = given or os.environ.get("SUDO_USER")
    if not operator:
        raise Refused(
            "no operator named. Run this through sudo from the operator's own "
            "login, or pass --operator <login>. Nothing was changed."
        )
    if operator in service_accounts or operator == "root":
        raise Refused(f"{operator} cannot be the operator. Nothing was changed.")
    try:
        pwd.getpwnam(operator)
    except KeyError:
        raise Refused(f"there is no account named {operator}. Nothing was changed.")
    return operator


def main(argv: list[str], system: System | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog=PROG, description="Create the service accounts Builder runs as."
    )
    parser.add_argument("--shape", required=True, choices=SHAPE_NAMES,
                        help="the account shape to create, check or remove")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true", help="say what would happen, change nothing")
    mode.add_argument("--check", action="store_true", help="report only; exit 1 on any failing row")
    mode.add_argument("--remove", action="store_true", help="delete the accounts this shape uses")
    parser.add_argument("--purge-homes", action="store_true",
                        help="with --remove, delete homes that are not empty")
    parser.add_argument("--operator", help="the operator's login (default: the user who ran sudo)")
    parser.add_argument("--install-json", default=ae.DEFAULT_INSTALL_JSON,
                        help="the install's record, read for --shape three's entities "
                        f"(default: {ae.DEFAULT_INSTALL_JSON})")
    args = parser.parse_args(argv)

    try:
        if args.purge_homes and not args.remove:
            raise Refused("--purge-homes only means something with --remove.")
        system = system or system_for_platform()
        # Every mode, --check and --dry-run included: the isolation rows run
        # `ls` as another account through sudo, and without root that fails
        # for every path, which reads exactly like a refused listing.
        if os.geteuid() != 0:
            raise Refused(f"this needs root. Run: sudo {sys.argv[0]} {' '.join(argv)}".rstrip())

        # Shape two is always the bare `agents` account; entities only shape
        # the three-account install.
        entities = ["default"]
        if args.shape == "three":
            try:
                entities = ae.read_entities(args.install_json)
            except ae.EntitiesInvalid as exc:
                raise Refused(str(exc))
        accounts = accounts_for(args.shape, system.platform, entities)
        ssh_names = ssh_accounts(accounts)

        if args.remove:
            changed = remove(system, args.shape, args.purge_homes, entities)
            print("\n".join(changed) or "nothing to remove")
            return 0

        operator = resolve_operator(args.operator, tuple(set(SERVICE_ACCOUNTS) | set(accounts)))
        report, _ = inspect(system, operator, args.shape, entities)
        if args.check or args.dry_run:
            control = controls(system, operator, ssh_names)
            print_table(f"{PROG}: {system.platform}, shape {args.shape}, operator {operator}",
                        report, control)
            if args.dry_run:
                refuse_wrong(report)
                for row in report.to_add:
                    print(f"would: {row.what}")
                return 0
            return 1 if any(not r.ok for r in report.rows + control.rows) else 0

        changed = provision(system, operator, args.shape, entities)
        # Asked again rather than assumed: the table printed after a change is
        # what the directory service now says.
        after, _ = inspect(system, operator, args.shape, entities)
        control = controls(system, operator, ssh_names)
        print_table(f"{PROG}: {system.platform}, shape {args.shape}, operator {operator}",
                    after, control)
        print()
        print("\n".join(changed) or f"nothing to do: {args.shape}-account shape already correct")
        failing = [r for r in after.rows + control.rows if not r.ok]
        if failing:
            print(f"\n{PROG}: {len(failing)} row(s) still fail after the change:", file=sys.stderr)
            for row in failing:
                print(f"  {row.what}", file=sys.stderr)
            return 1
        return 0

    except Refused as exc:
        print(f"{PROG}: refusing: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
