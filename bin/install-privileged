# What install.json keeps. Every other setting is a test setting. An install.json
# written before library_repo or convivy_orient_repo existed has neither, and still
# loads: merged_config fills them from DEFAULTS.
PERSISTED = ("org", "agent_platform_repo", "shipwright_repo", "library_repo",
             "convivy_orient_repo", "shape", "library_account")
# Shape two fetches all four repositories, so its record names all four,
# beside the organisation and the shape, as the plan's Handoff sets out.
PERSISTED_TWO = ("org", "shipwright_repo", "agent_platform_repo", "library_repo",
                 "convivy_orient_repo", "shape")
# Shape three's entities, read by account_entities rather than merged into a
# flag-settable setting: tolerated here so an entities list an operator
# placed in install.json by hand does not refuse as an unknown key, and
# carried forward byte-for-byte whenever this rewrites the file, never
# fabricated when it was never there.
ENTITIES_KEY = "entities"
# The review launcher's account map, written only on a multi-entity install:
# tolerated as an unknown key the same way ENTITIES_KEY is, since this only
# ever writes it fresh from `entities` and never reads it back into cfg.
ACCOUNTS_KEY = "accounts"
# Whether this install follows Orient's `main`: only `orient-deploy --enable`
# writes it, and only `true` turns the deploy step on. Tolerated and carried
# forward byte-for-byte the same way ENTITIES_KEY is, never fabricated, so a
# fresh install has no such key and a replay never drops one a person set.
FOLLOW_ORIENT_MAIN_KEY = "follow_orient_main"
# The approver App's id, a public value (every check-run response carries
# app.id), kept here so an account without the key's root-only slot can still
# read which App it signs for. Tolerated as an unknown key the same way
# ENTITIES_KEY is. Every run derives it fresh from the id slot
# `github-gate --place-key` writes once GitHub has vouched for the key, since
# that slot is the single source and a key may be placed before install.json
# exists at all; where no id is placed, the stored value carries forward
# byte-for-byte, never fabricated.
APPROVER_APP_ID_KEY = "approver_app_id"
CARRIED_KEYS = (ENTITIES_KEY, FOLLOW_ORIENT_MAIN_KEY, APPROVER_APP_ID_KEY)
# GitHub's web-flow public key, the keyring root's deploy step verifies each
# merge on Orient's `main` against. Read from the tree's payload and placed
# under the root-only `etc`, on both shapes. A rotation is a reviewed change to
# the payload file, which the next install places.
WEB_FLOW_SOURCE = "payload/etc/github-web-flow.asc"
WEB_FLOW_KEYRING = "etc/github-web-flow.asc"
# The deploy step's entry point, which the root job runs: it execs the copy of
# `orient-deploy` in the newest tree this installed, as `update-privileged`
# does for this file.
DEPLOY_ENTRY = "libexec/orient-deploy"
# What fixtures.json may name. Honoured only where the prefix is not the real root.
FIXTURE_KEYS = ("github_base", "download_base", "api_base", "interpreter", "sudoers_dir",
                "visudo", "pip_args", "homes", "require_root")


def carry_entities(stored: dict, persisted: dict) -> None:
    """Carry `stored`'s `entities` and `follow_orient_main` keys into
    `persisted` byte-for-byte, so neither shape's rewrite of install.json
    ever drops or fabricates them. `approver_app_id` is not one of these:
    `approver_app_id_setting` below derives it fresh instead."""
    for key in (ENTITIES_KEY, FOLLOW_ORIENT_MAIN_KEY):
        if key in stored:
            persisted[key] = stored[key]


def approver_app_id_setting(stored: dict, prefix: str) -> str | None:
    """install.json's `approver_app_id`, read fresh from the root-only id
    slot when `github-gate --place-key` has placed one there: that slot is
    the single source, and a key may be placed before install.json exists at
    all, so the id can get ahead of anything install.json remembers on its
    own. Where no id is placed, `stored`'s own value carries forward
    byte-for-byte, never fabricated. None when neither names one."""
    raw = gg.read_slot(os.path.join(prefix, gg.ID_SLOT))
    if raw:
        return raw.decode("ascii", "replace").strip()
    return stored.get(APPROVER_APP_ID_KEY)


def account_map(entities: list[str], prefix: str) -> dict:
    """The `accounts` key a multi-entity install gets: one entry per entity,
    naming its agents and reviewers account and the absolute path of its own
    reviewers Claude-token slot. Empty on a single entity, where the review
    launcher falls back to the bare `agents`, `reviewers` and CLAUDE_SLOT
    names."""
    if len(entities) == 1:
        return {}
    return {
        entity: {
            "agents": agents,
            "reviewers": reviewers,
            "reviewers_claude_token": os.path.join(prefix, claude_slot_rel(entity, entities)),
        }
        for entity, (agents, reviewers) in zip(entities, ae.account_pairs(entities))
    }


def persisted_two(stored: dict, cfg: dict, prefix: str) -> dict:
    """What `install_two` writes back to install.json: PERSISTED_TWO's keys,
    `entities` and `follow_orient_main` carried forward exactly as stored,
    when present, and `approver_app_id` set from `approver_app_id_setting`."""
    persisted = {k: cfg[k] for k in PERSISTED_TWO if k in cfg}
    carry_entities(stored, persisted)
    app_id = approver_app_id_setting(stored, prefix)
    if app_id is not None:
        persisted[APPROVER_APP_ID_KEY] = app_id
    return persisted


def persisted_three(stored: dict, cfg: dict, prefix: str) -> dict:
    """What `install_three` writes back to install.json: PERSISTED's keys,
    `entities` and `follow_orient_main` carried forward exactly as stored,
    `approver_app_id` set from `approver_app_id_setting`, and `accounts`
    recomputed fresh from `cfg["entities"]` on every run, so a stale map, or
    one left from an install that has since dropped to one entity, never
    outlives the change."""
    persisted = {k: cfg[k] for k in PERSISTED}
    carry_entities(stored, persisted)
    app_id = approver_app_id_setting(stored, prefix)
    if app_id is not None:
        persisted[APPROVER_APP_ID_KEY] = app_id
    accounts = account_map(cfg["entities"], prefix)
    if accounts:
        persisted[ACCOUNTS_KEY] = accounts
    return persisted


def token() -> str:
    return secrets.token_hex(8)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog=PROG, description="The root-owned half of Builder's install.")
    p.add_argument("--shape", choices=("two", "three"), default=None,
                   help="the install shape: two (all four repositories, no review "
                        "launcher) or three (also the review launcher, reviewers' "
                        "tools and sudo rule)")
    p.add_argument("--release", default=None, metavar="TAG",
                   help="the release tag to install (shape two, or shape three fetched "
                        "anonymously)")
    p.add_argument("--org", help="the GitHub organisation that holds the repositories")
    p.add_argument("--agent-platform-repo", help="the agent-platform repository's name")
    p.add_argument("--shipwright-repo", help="the shipwright repository's name")
    p.add_argument("--library-repo", help="the library repository's name")
    p.add_argument("--convivy-orient-repo", help="the convivy-orient repository's name")
    p.add_argument("--commit", action="append", default=[], metavar="REPO=SHA",
                   help="check REPO's tag against this commit before fetching it (shape two, "
                        "optional, or shape three given --release, required for every "
                        "repository); install this commit of REPO instead of its main (shape "
                        "three with no --release). Repeatable.")
    p.add_argument("--consent", choices=("ask", "yes", "no"), default=None,
                   help="answer the instruction-file question without asking")
    p.add_argument("--restore-previous", action="store_true",
                   help="reinstall the root half this install last replaced, from the "
                        "trees already on the machine; fetches nothing")
    return p


# Reading and writing under the prefix.

def write_atomic(path: str, data: bytes, mode: int) -> None:
    """Write `data` to `path` owned by root with `mode`, by write-then-rename."""
    tmp = f"{path}.tmp-{token()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, "wb") as f:
            os.fchown(f.fileno(), gg.ROOT_UID, gg.ROOT_GID)
            os.fchmod(f.fileno(), mode)
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        if os.path.lexists(tmp):
            os.unlink(tmp)
        raise


def open_beneath(root: str, parts: tuple[str, ...]) -> int:
    """A descriptor for `root/<parts>`, opening each name from the directory above it with
    O_NOFOLLOW, so no link anywhere on the way is followed. A FIFO cannot block the open."""
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
    dirfd = os.open(root, flags | os.O_DIRECTORY)
    try:
        for name in parts[:-1]:
            nxt = os.open(name, flags | os.O_DIRECTORY, dir_fd=dirfd)
            os.close(dirfd)
            dirfd = nxt
        return os.open(parts[-1], flags, dir_fd=dirfd)
    finally:
        os.close(dirfd)


def read_beneath(root: str, parts: tuple[str, ...], *, one_name: bool = False) -> bytes | None:
    """A regular file's bytes under `root`, None when it is absent. Refused when a link is on
    the path or the file is not regular, and with `one_name`, when it has a second name. A
    refusal never includes the file's bytes."""
    shown = os.path.join(root, *parts)
    try:
        fd = open_beneath(root, parts)
    except FileNotFoundError:
        return None
    except OSError as exc:
        raise Refused(f"{shown} cannot be read without following a link ({exc.strerror}). "
                      f"Nothing was changed.")
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode):
            raise Refused(f"{shown} is not a regular file. Nothing was changed.")
        if one_name and st.st_nlink != 1:
            raise Refused(f"{shown} has more than one name, so it is refused. Nothing was changed.")
        return f.read()


def read_tree_file(tree: str, rel: str) -> bytes:
    data = read_beneath(tree, tuple(pathlib.PurePosixPath(rel).parts))
    if data is None:
        raise Refused(f"{rel} is missing from {tree}. Nothing was changed.")
    return data


# The launcher's own shebang names agent-platform's build account's interpreter
# (a Homebrew path on macOS), which root cannot run. Matched here so the line
# this installs instead, naming the interpreter `cfg["interpreter"]` resolved
# for root's own platform, replaces a line of the same shape rather than an
# upstream launcher that changed underneath this check.
LAUNCHER_SHEBANG = re.compile(r"^#!\S+/python3(?:\.\d+)?[ \t]+-I\b")


def rewrite_launcher_shebang(data: bytes, interpreter: str) -> bytes:
    """`data` (the launcher as agent-platform ships it) with its first line
    replaced by a shebang naming `interpreter`, the root interpreter resolved
    for this platform, so sudo can run the file it places. Refused, naming
    the line, when the first line is not `#!` followed by a path ending in
    `python3` (optionally versioned) and `-I`."""
    newline = data.find(b"\n")
    first_line = data if newline == -1 else data[:newline]
    text = first_line.decode("utf-8", "replace")
    if not LAUNCHER_SHEBANG.match(text):
        raise Refused(f"{LAUNCHER}'s first line is {printable(text)!r}, not a #! line naming a "
                      f"python3 interpreter with -I. Refusing to place it rewritten. "
                      f"Nothing was changed.")
    rest = b"" if newline == -1 else data[newline:]
    return f"#!{interpreter} -I".encode("utf-8") + rest


def own_tree(path: str) -> None:
    """Root owns everything under `path`, and no group or other account can write it."""
    for target in [path] + [os.path.join(d, n) for d, dirs, files in os.walk(path)
                            for n in dirs + files]:
        st = os.lstat(target)
        os.lchown(target, gg.ROOT_UID, gg.ROOT_GID)
        if not stat.S_ISLNK(st.st_mode):
            os.chmod(target, st.st_mode & 0o7777 & ~0o022)


def make_dir(path: str, mode: int) -> None:
    gg.make_root_dir(path, mode)


def remove(path: str) -> None:
    if os.path.isdir(path) and not os.path.islink(path):
        shutil.rmtree(path)
    elif os.path.lexists(path):
        os.unlink(path)


class Plan:
    """Artifacts built beside their live paths. Nothing live changes until `swap`; a refusal
    before then removes what was built."""

    def __init__(self) -> None:
        self.moves: list[tuple[str, str]] = []

    def stage(self, staged: str, live: str) -> None:
        self.moves.append((staged, live))

    def discard(self) -> None:
        for staged, _ in self.moves:
            remove(staged)

    def swap(self) -> None:
        retired = []
        for staged, live in self.moves:
            if os.path.isdir(live) and not os.path.islink(live):
                old = f"{live}.old-{token()}"
                os.rename(live, old)
                retired.append(old)
            os.replace(staged, live)
        for old in retired:
            shutil.rmtree(old)


def stage_file(plan: Plan, live: str, data: bytes, mode: int) -> None:
    staged = f"{live}.new-{token()}"
    write_atomic(staged, data, mode)
    plan.stage(staged, live)


def check_settings_file(path: str) -> None:
    """Refuse a settings file that is not a regular file the root account owns, with no group
    or other write bit. Both settings files are read as root, so both get this check."""
    st = os.lstat(path)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != gg.ROOT_UID or st.st_mode & 0o022:
        raise Refused(f"{path} must be a root-owned file that no other account can write. "
                      f"Nothing was changed.")


def load_config(prefix: str) -> dict:
    path = os.path.join(prefix, CONFIG)
    if not os.path.lexists(path):
        return {}
    check_settings_file(path)
    try:
        return json.loads((read_beneath(prefix, (CONFIG,)) or b"{}").decode("utf-8"))
    except ValueError as exc:
        raise Refused(f"{path} is not JSON ({exc}). Nothing was changed.")


def fixture_settings(prefix: str) -> dict:
    """The test settings in `fixtures.json`. Honoured only where the install root is not the
    real one, and the installer never writes the file."""
    if not os.path.lexists(os.path.join(prefix, FIXTURES)):
        return {}
    if prefix == REAL_ROOT or prefix.startswith(REAL_ROOT + "/"):
        raise Refused(f"{prefix}/{FIXTURES} holds test settings, and the real install root does not "
                      f"honour them. Remove it. Nothing was changed.")
    check_settings_file(os.path.join(prefix, FIXTURES))
    try:
        data = json.loads((read_beneath(prefix, (FIXTURES,)) or b"{}").decode("utf-8"))
    except ValueError as exc:
        raise Refused(f"{prefix}/{FIXTURES} is not JSON ({exc}). Nothing was changed.")
    if not isinstance(data, dict) or set(data) - set(FIXTURE_KEYS):
        raise Refused(f"{prefix}/{FIXTURES} may name only: {', '.join(FIXTURE_KEYS)}.")
    return data


def merged_config(stored: dict, fixtures: dict, args: argparse.Namespace) -> dict:
    extra = sorted(set(stored) - set(PERSISTED) - {*CARRIED_KEYS, ACCOUNTS_KEY})
    if extra:
        raise Refused(f"{CONFIG} names {', '.join(extra)}, which is not a persisted setting. "
                      f"Nothing was changed.")
    cfg = {**DEFAULTS, **{k: stored[k] for k in PERSISTED if k in stored}, **fixtures}
    for key, value in (("org", args.org), ("agent_platform_repo", args.agent_platform_repo),
                       ("shipwright_repo", args.shipwright_repo), ("library_repo", args.library_repo),
                       ("convivy_orient_repo", args.convivy_orient_repo),
                       ("shape", args.shape)):
        if value is not None:
            cfg[key] = value
    if not cfg.get("org") or not ORG.fullmatch(cfg["org"]):
        raise Refused("name the GitHub organisation with --org (a single name, no slash).")
    if cfg.get("shape") not in ("two", "three"):
        raise Refused("name the install shape with --shape two or --shape three.")
    if not str(cfg["download_base"]).startswith(("https://", "http://")):
        raise Refused("the Claude download base must be an http or https URL.")
    # Recorded before the default fill below, since that is the only other way
    # cfg["interpreter"] gets a value: install.json never persists "interpreter".
    cfg["interpreter_from_fixture"] = bool(fixtures.get("interpreter"))
    if not cfg.get("interpreter"):
        system = platform_mod.system()
        if system not in INTERPRETERS:
            raise Refused(f"there is no default interpreter for {system}.")
        cfg["interpreter"] = INTERPRETERS[system]
    if not os.path.isabs(cfg["interpreter"]):
        raise Refused("the interpreter must be an absolute path.")
    return cfg


def parse_commits(items: list[str], names: dict[str, str]) -> dict[str, str]:
    """`--commit repo=sha`, one per repository. A bare SHA is refused."""
    out: dict[str, str] = {}
    known = sorted(names.values())
    for item in items:
        m = COMMIT_ARG.fullmatch(item)
        if not m:
            raise Refused(f"--commit takes <repo>=<40-hex SHA>, one per repository, and "
                          f"{printable(item)!r} is not that. A bare SHA is refused: name its repository.")
        repo, sha = m.groups()
        if repo not in known:
            raise Refused(f"--commit names {repo!r}, which is not one of {', '.join(known)}.")
        if repo in out:
            raise Refused(f"--commit names {repo!r} twice.")
        out[repo] = sha
    return out


def claude_platform() -> str:
    key = (platform_mod.system(), platform_mod.machine())
    if key not in CLAUDE_PLATFORMS:
        raise Refused(f"there is no Claude pin for {key[0]} {key[1]}.")
    return CLAUDE_PLATFORMS[key]


def parse_pin(text: str) -> tuple[str, dict[str, str]]:
    """The pin's shape and nothing more: `claude:`, a version, and a sha256 per platform."""
    version = None
    pins: dict[str, str] = {}
    saw_claude = False
    for number, raw in enumerate(text.splitlines(), 1):
        line = raw.rstrip()
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if line == "claude:":
            saw_claude = True
        elif line == "  sha256:":
            continue
        elif (m := PIN_VERSION.fullmatch(line)):
            version = m.group(1)
        elif (m := PIN_SHA.fullmatch(line)):
            pins[m.group(1)] = m.group(2)
        else:
            raise Refused(f"{PIN} line {number} is outside the pin's shape (claude, version, "
                          f"sha256 per platform): {printable(line)!r}")
    if not saw_claude or version is None or not pins:
        raise Refused(f"{PIN} names no claude version or no sha256 per platform.")
    return version, pins


# Git and GitHub.

def git_in(bare: str, *args: str, token_value: str | None = None) -> subprocess.CompletedProcess:
    env = dict(CLEAN_ENV)
    if token_value is not None:
        basic = base64.b64encode(f"x-access-token:{token_value}".encode()).decode("ascii")
        env.update(GIT_CONFIG_COUNT="1", GIT_CONFIG_KEY_0="http.extraHeader",
                   GIT_CONFIG_VALUE_0=f"Authorization: Basic {basic}", GIT_TERMINAL_PROMPT="0")
    return subprocess.run([GIT, "-c", "credential.helper=", f"--git-dir={bare}", *args],
                          env=env, cwd="/", capture_output=True, check=False)


def tail(data: bytes) -> str:
    lines = data.decode("utf-8", "replace").strip().splitlines()
    return printable(" | ".join(lines[-3:])) or "no output"


def ensure_bare(path: str) -> None:
    if os.path.lexists(path):
        return
    done = subprocess.run([GIT, "init", "--bare", "-q", path], env=CLEAN_ENV, cwd="/",
                          capture_output=True)
    if done.returncode:
        raise Refused(f"git could not create {path}: {tail(done.stderr)}")
    own_tree(path)


def read_token(gh, jwt: str, org: str, repo: str) -> str:
    """A token that reads `repo`'s contents and nothing else."""
    inst = gg.installation_for(gh, jwt, org)
    code, payload = gh.request(
        "POST", f"{gh.api}/app/installations/{inst['id']}/access_tokens", jwt,
        {"permissions": {"contents": "read"}, "repositories": [repo]},
    )
    value = payload.get("token") if code == 201 and isinstance(payload, dict) else None
    if not value:
        raise Refused(f"GitHub refused a read token for {repo} ({code}: "
                      f"{gg.message(payload)}). Nothing was changed.")
    return value


def fetch_main(bare: str, url: str, value: str) -> None:
    done = git_in(bare, "fetch", "--no-tags", "--no-write-fetch-head", "--quiet", url,
                  f"+{MAIN}:{MAIN}", token_value=value)
    if done.returncode:
        raise Refused(f"git could not fetch main from {url}: {tail(done.stderr)}. "
                      f"Nothing was installed from it.")


def main_head(bare: str) -> str:
    done = git_in(bare, "rev-parse", "--verify", "--quiet", f"{MAIN}^{{commit}}")
    if done.returncode:
        raise Refused(f"{bare} has no {MAIN} after the fetch. Nothing was installed.")
    return done.stdout.decode().strip()


def is_on_main(bare: str, sha: str) -> bool:
    return git_in(bare, "merge-base", "--is-ancestor", sha, MAIN).returncode == 0


# The shape-two fetch: anonymous HTTPS, release by tag, four-step order.

TAG = re.compile(r"^v[0-9]+\.[0-9]+\.[0-9]+(-(alpha|beta|rc)(\.?[0-9]+)?)?$")


def remote_tag_commit(url: str, tag: str, *, token_value: str | None = None) -> str:
    """The commit the remote's tag resolves to, read with `git ls-remote` under the
    cleared environment. Takes the peeled line (`refs/tags/<tag>^{}`) for an
    annotated tag; the unpeeled line names the tag object. Changes no local ref.
    `token_value`, given, is sent the same way `git_in` sends any other token."""
    done = git_in("", "ls-remote", "--quiet", url,
                  f"refs/tags/{tag}", f"refs/tags/{tag}^{{}}", token_value=token_value)
    if done.returncode:
        raise Refused(f"git could not read tag {tag} from {url}: {tail(done.stderr)}. "
                      f"Nothing was fetched.")
    peeled = None
    for line in done.stdout.decode().splitlines():
        fields = line.split(None, 1)
        if len(fields) == 2 and fields[1] == f"refs/tags/{tag}^{{}}":
            peeled = fields[0]
            break
    if peeled is None:
        for line in done.stdout.decode().splitlines():
            fields = line.split(None, 1)
            if len(fields) == 2 and fields[1] == f"refs/tags/{tag}":
                peeled = fields[0]
                break
    if not peeled or not SHA.fullmatch(peeled):
        raise Refused(f"tag {tag} is not on {url}, or does not resolve to a commit. "
                      f"Nothing was fetched.")
    return peeled


def recorded_tag(records: str, name: str, tag: str) -> str | None:
    """The commit `src/installed` records for `name`'s `tag`, or None when the pair is new.

    Each repository's tag resolves to a different commit, so the record names the
    repository: `tag <repo> <tag> <sha>`. A line with no repository name (the format
    before this check existed) never matches, and is read by nothing here."""
    for line in records.splitlines():
        fields = line.split()
        if len(fields) == 4 and fields[0] == "tag" and fields[1] == name and fields[2] == tag:
            if SHA.fullmatch(fields[3]):
                return fields[3]
    return None


def last_recorded_commit(records: str, name: str) -> str | None:
    """The last commit `src/installed` recorded for `name`, or None on a first install."""
    for line in records.splitlines():
        fields = line.split()
        if len(fields) == 2 and fields[0] == name and SHA.fullmatch(fields[1]):
            return fields[1]
    return None


def fetch_tag(bare: str, url: str, tag: str, *, token_value: str | None = None) -> None:
    """Fetch `main` and the tag without force, so a tag that moved on the remote is
    refused rather than overwritten. A failed fetch is a refusal; root never retries
    with force."""
    done = git_in(bare, "fetch", "--no-write-fetch-head", "--quiet", url,
                  f"{MAIN}:{MAIN}", f"refs/tags/{tag}:refs/tags/{tag}", token_value=token_value)
    if done.returncode:
        raise Refused(f"git could not fetch tag {tag} from {url}: {tail(done.stderr)}. "
                      f"Nothing was installed from it.")


def peeled_tag_commit(bare: str, tag: str) -> str:
    """The commit the fetched tag resolves to, peeled with `rev-parse`."""
    done = git_in(bare, "rev-parse", "--verify", "--quiet", f"refs/tags/{tag}^{{commit}}")
    if done.returncode:
        raise Refused(f"the fetched tag {tag} does not resolve to a commit. "
                      f"Nothing was installed.")
    return done.stdout.decode().strip()


def is_ancestor(bare: str, ancestor: str, descendant: str) -> bool:
    return git_in(bare, "merge-base", "--is-ancestor", ancestor, descendant).returncode == 0


def parse_release_tag(value: str) -> str:
    """Normalise and validate a `--release` value into a `v<semver>` tag."""
    tag = value[1:] if value.startswith("v") else value
    if not TAG.fullmatch(f"v{tag}"):
        raise Refused(f"'{value}' is not a release tag. Pass --release with a tag "
                      f"such as v1.0.0. Nothing was changed.")
    return f"v{tag}"


def fetch_release_tag(bare: str, name: str, url: str, tag: str, prior_records: str,
                      expected: str | None = None, *, token_value: str | None = None) -> str:
    """One repository's tag, fetched by the four-step order (ls-remote, recorded-tag
    check, fetch without force, peel and ancestry): a tag moved backward, or a recorded
    tag moved forward, is refused. `expected`, when given, is the commit `--commit` named
    for `name`; a mismatch with the remote's own tag is refused before anything is
    fetched from this repository, and chooses nothing. `token_value`, given, is sent with
    every step that reaches the remote, for convivy-orient's fallback on the two-account
    shape. Returns the peeled commit."""
    # Step 1: read the tag's commit from the remote. Changes no local ref.
    remote_commit = remote_tag_commit(url, tag, token_value=token_value)
    print(f"remote: tag {tag} -> {remote_commit}")

    if expected is not None and expected != remote_commit:
        raise Refused(f"--commit named {expected} for {name}, and {url}'s tag {tag} names "
                      f"{remote_commit}. Nothing was fetched.")

    # Step 2: refuse a recorded tag name that now names a different commit, fetching nothing.
    prior = recorded_tag(prior_records, name, tag)
    if prior is not None and prior != remote_commit:
        raise Refused(f"tag {tag} was recorded at {prior} for {name}, and {url} now names "
                      f"{remote_commit}. A recorded tag that moved is refused. Nothing was fetched.")

    # Step 3: fetch main and the tag without force. A failed fetch is a refusal.
    ensure_bare(bare)
    fetch_tag(bare, url, tag, token_value=token_value)

    # Step 4: peel, verify against the remote commit, and check ancestry.
    peeled = peeled_tag_commit(bare, tag)
    if peeled != remote_commit:
        raise Refused(f"the fetched tag {tag} of {name} resolves to {peeled}, but the remote "
                      f"named {remote_commit}. Nothing was installed.")
    if not is_on_main(bare, peeled):
        raise Refused(f"{peeled} (tag {tag}) is not on {MAIN} of {name}. Nothing was installed.")
    last_commit = last_recorded_commit(prior_records, name)
    if last_commit is not None and not is_ancestor(bare, last_commit, peeled):
        raise Refused(f"{peeled} (tag {tag}) does not descend from {last_commit}, the commit this "
                      f"install last recorded for {name}. A tag moved backward is refused. "
                      f"Nothing was installed.")
    return peeled


# How long the visibility probe gets to answer, below.
ORIENT_VISIBILITY_TIMEOUT = 15


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """Refuses to follow a redirect: the probe's own status reaches the caller as
    an HTTPError instead of a followed response."""

    def redirect_request(self, *args, **kwargs):
        return None


def orient_visible(url: str) -> bool:
    """Whether `url`'s repository is public over anonymous HTTPS: one GET of
    `<url>.git/info/refs?service=git-upload-pack`, the request `git` itself makes
    to learn whether a remote takes the smart protocol, with no credential and no
    redirect followed. True on 200 (public). False on 401 (private: the two-account
    shape's convivy-orient fetch needs the Orient read key). Any other status, a
    redirect, a connection that fails, or a timeout refuses, naming what happened;
    nothing is changed.

    A `url` that is not http or https (a test fixture's `file://` remote) is always
    public: there is no HTTP credential concept for it, and a repository missing
    there fails the ordinary four-step order's own `ls-remote` instead, exactly as
    it does for the other three repositories."""
    if not url.startswith(("http://", "https://")):
        return True
    probe = f"{url}.git/info/refs?service=git-upload-pack"
    opener = urllib.request.build_opener(_NoRedirect(), urllib.request.ProxyHandler({}))
    try:
        with opener.open(probe, timeout=ORIENT_VISIBILITY_TIMEOUT) as resp:
            status = resp.status
    except urllib.error.HTTPError as exc:
        status = exc.code
    except (urllib.error.URLError, OSError) as exc:
        raise Refused(f"could not read {probe} ({exc}). Nothing was changed.")
    if status == 200:
        return True
    if status == 401:
        return False
    raise Refused(f"{probe} answered {status}, neither 200 (public) nor 401 (private). "
                  f"Nothing was changed.")


def convivy_orient_token(cfg: dict, prefix: str, name: str, url: str, tag: str
                         ) -> tuple[str | None, object | None]:
    """Whether the two-account shape's convivy-orient fetch needs a credential,
    decided by `orient_visible`. (None, None) when `url` is public: the organisation
    publishes convivy-orient, so this never reads the Orient read key slot. Otherwise
    a token minted from the placed Orient read key, reusing `read_token` exactly as
    `orient-deploy` does, and the bound `GitHub.revoke` the caller runs on that token
    once the fetch using it finishes, in a `finally`, win or lose; refuses, naming
    `github-gate --place-key --orient-read`, when no key is placed, before anything
    else is fetched."""
    if orient_visible(url):
        return None, None
    key_path, app_id = gg.placed_key(prefix, orient_read=True)
    jwt = gg.app_jwt(key_path, app_id)
    gh = gg.GitHub(api=cfg["api_base"])
    return read_token(gh, jwt, cfg["org"], name), gh.revoke


def extract(prefix: str, bare: str, name: str, sha: str) -> str:
    """The tree of `name` at `sha`, root-owned. An existing tree for the same SHA is the same tree."""
    dest = os.path.join(prefix, "src", f"{name}@{sha}")
    label = f"{name}@{sha}"
    if os.path.lexists(dest):
        if not os.path.isdir(dest) or os.path.islink(dest):
            raise Refused(f"{dest} is not a plain directory. Nothing was changed.")
        return dest
    listing = git_in(bare, "ls-tree", "-r", "-z", "--full-tree", sha)
    if listing.returncode:
        raise Refused(f"git could not list {label}: {tail(listing.stderr)}")
    for entry in listing.stdout.split(b"\0"):
        meta, _, path = entry.partition(b"\t")
        mode = meta.split(b" ")[0]
        if mode in LINK_MODES:
            kind = "a symbolic link" if mode == b"120000" else "a submodule (gitlink)"
            raise Refused(f"{label} holds {printable(path.decode('utf-8', 'replace'))} as {kind}. "
                          f"A tree with one is refused. Nothing was changed.")
    archive = git_in(bare, "archive", "--format=tar", sha)
    if archive.returncode:
        raise Refused(f"git could not archive {sha} of {name}: {tail(archive.stderr)}")
    staged = f"{dest}.tmp-{token()}"
    os.mkdir(staged, 0o755)
    done = subprocess.run([TAR, "-x", "-f", "-", "-C", staged], input=archive.stdout,
                          env=CLEAN_ENV, cwd="/", capture_output=True, check=False)
    if done.returncode:
        shutil.rmtree(staged, ignore_errors=True)
        raise Refused(f"tar could not extract {label}: {tail(done.stderr)}")
    own_tree(staged)
    os.rename(staged, dest)
    return dest


def stage_library(plan: Plan, tree: str, dst: str) -> None:
    """The library's top-level Python modules, staged as one directory and swapped in whole."""
    src = os.path.join(tree, LIBRARY)
    staged = f"{dst}.new-{token()}"
    os.mkdir(staged, 0o755)
    plan.stage(staged, dst)
    for name in sorted(os.listdir(src)):
        if name.endswith(".py"):
            write_atomic(os.path.join(staged, name),
                         read_tree_file(tree, f"{LIBRARY}/{name}"), 0o644)
    own_tree(staged)


# Accounts and the instruction file.

# **`library_account` TELLS THE LIBRARY IT RUNS IN ITS OWN ACCOUNT.** The Library's
# person-save route reads it from this file to decide whether a save crossed an
# account boundary (the Library's protocol, on saving a person): absent means
# no boundary, and a name the machine lacks, or one the Library does not run as, is
# refused. `shape` cannot answer that, because shape two gains a Library account
# only later. The value is worked out on every shape-three run rather than carried
# from the stored file, so an update rewrites it instead of dropping it, and a run
# whose account is missing refuses before anything is written. The names match
# `LIBRARY_ACCOUNT_NAMES` in bin/provision-accounts, which creates the account first;
# tools/test_install_privileged.py checks that the two tables agree.
LIBRARY_ACCOUNT_NAMES = {"macos": "_library", "linux": "library"}


def library_account(cfg: dict) -> str:
    name = LIBRARY_ACCOUNT_NAMES["macos" if platform_mod.system() == "Darwin" else "linux"]
    home_of(cfg, name)
    return name


def home_of(cfg: dict, account: str) -> str:
    if account in cfg["homes"]:
        return cfg["homes"][account]
    if platform_mod.system() == "Darwin":
        done = subprocess.run([DSCL, ".", "-read", "/Users/" + account, "NFSHomeDirectory"],
                              env=CLEAN_ENV, cwd="/", capture_output=True, check=False)
        value = done.stdout.decode().partition(":")[2].strip() if done.returncode == 0 else ""
    else:
        done = subprocess.run([GETENT, "passwd", account], env=CLEAN_ENV, cwd="/",
                              capture_output=True, check=False)
        fields = done.stdout.decode().strip().split(":")
        value = fields[5] if done.returncode == 0 and len(fields) > 5 else ""
    if not value.startswith("/"):
        raise Refused(f"the directory service has no account {account}. Create it with "
                      f"bin/provision-accounts --shape three first.")
    return value


# Duplicated from `bin/provision-accounts`' own `ORIENT_ACCOUNT_NAMES` and
# `ORIENT_TUNNEL_GROUP` the same way `LIBRARY_ACCOUNT_NAMES` above is:
# tools/test_install_privileged.py checks that the account-name tables agree.
# `verify_ownership` reads both to recognise `{prefix}/run/orient`, the socket
# directory provision-accounts creates and owns as Orient.
ORIENT_ACCOUNT_NAMES = {"macos": "_orient", "linux": "orient"}
ORIENT_TUNNEL_GROUP = "orient-tunnel"


def orient_identity() -> tuple[int | None, int | None]:
    """(Orient's own account's uid, ORIENT_TUNNEL_GROUP's gid) on this platform,
    each None when the directory service has not created it yet. Looked up
    fresh on every call, not cached, so a run sees an account or group
    bin/provision-accounts just created."""
    name = ORIENT_ACCOUNT_NAMES["macos" if platform_mod.system() == "Darwin" else "linux"]
    try:
        uid = pwd.getpwnam(name).pw_uid
    except KeyError:
        uid = None
    try:
        gid = grp.getgrnam(ORIENT_TUNNEL_GROUP).gr_gid
    except KeyError:
        gid = None
    return uid, gid


def consent(mode: str) -> bool:
    if mode == "yes":
        return True
    if mode == "no":
        return False
    try:
        answer = input("Install the account's edit above as the reviewers' instruction file? [y/N] ")
    except EOFError:
        return False
    return answer.strip().lower() in ("y", "yes")


def stage_instructions(cfg: dict, args, sw_tree: str, rv: str, plan: Plan) -> None:
    """The reviewers' one instruction file. Each entity's agents account may
    hold its own edit of the shipped file; each edit that differs is shown in
    entity order, and the first one accepted is taken. With one entity this
    is the bare `agents` account alone, as before entities existed."""
    shipped = read_tree_file(sw_tree, INSTRUCTIONS)
    chosen = shipped
    for account, _reviewers in ae.account_pairs(cfg["entities"]):
        home = home_of(cfg, account)
        held = read_beneath(home, (".claude", "CLAUDE.md"), one_name=True)
        if held is None or held == shipped:
            continue
        held_path = printable(os.path.join(home, ".claude", "CLAUDE.md"))
        print(f"the {account} account's {held_path} differs from the shipped {INSTRUCTIONS}:")
        sys.stdout.write("".join(difflib.unified_diff(
            printable(shipped.decode("utf-8", "replace")).splitlines(keepends=True),
            printable(held.decode("utf-8", "replace")).splitlines(keepends=True),
            fromfile=f"shipped {INSTRUCTIONS}", tofile=held_path)))
        if consent(args.consent):
            chosen = held
            print(f"reviewers/CLAUDE.md takes the {account} account's edit.")
            break
        print(f"reviewers/CLAUDE.md does not take the {account} account's edit.")
    if chosen is shipped:
        print(f"reviewers/CLAUDE.md takes the shipped {INSTRUCTIONS}.")
    stage_file(plan, os.path.join(rv, "CLAUDE.md"), chosen, 0o644)


# The launcher, the sudo rule and the reviewers' tools.

def stage_sudo_rule(cfg: dict, sw_tree: str, launcher: str, plan: Plan) -> None:
    """One Defaults/rule pair per entity's agents account, rendered by
    `account_entities.render_sudoers` so uninstall-builder's own expected
    content can never drift from what this writes."""
    template = read_tree_file(sw_tree, SUDOERS_TEMPLATE).decode("utf-8")
    agents_names = [pair[0] for pair in ae.account_pairs(cfg["entities"])]
    text = ae.render_sudoers(template, agents_names, launcher).encode("utf-8")
    sudoers = cfg["sudoers_dir"]
    staged = os.path.join(sudoers, f".{SUDOERS_NAME}.tmp-{token()}")
    write_atomic(staged, text, 0o440)
    plan.stage(staged, os.path.join(sudoers, SUDOERS_NAME))
    done = subprocess.run([cfg["visudo"], "-c", "-f", staged], env=CLEAN_ENV, cwd="/",
                          capture_output=True, check=False)
    if done.returncode:
        raise Refused(f"visudo refused the sudo rule, so nothing was placed: {tail(done.stderr + done.stdout)}")


def venv_interpreter(cfg: dict) -> str:
    """The interpreter the reviewers' venv is built on. An interpreter named in
    fixtures.json wins outright. Otherwise, on Darwin, Homebrew's own python3 (the
    default `cfg["interpreter"]` takes) may be a version with no wheel for the
    reviewers' locked packages, so the venv is built on the pinned CPython
    install_pinned_python places at <prefix>/python/<PYTHON_VERSION>/bin/python3
    instead. Linux keeps `cfg["interpreter"]`."""
    if not cfg["interpreter_from_fixture"] and platform_mod.system() == "Darwin":
        return os.path.join(cfg["prefix"], "python", PYTHON_VERSION, "bin", "python3")
    return cfg["interpreter"]


def stage_venv(cfg: dict, ap_tree: str, rv: str, plan: Plan) -> None:
    lock = os.path.join(ap_tree, LOCK)
    staging = os.path.join(rv, f"venv.staging-{token()}")
    plan.stage(staging, os.path.join(rv, "venv"))
    made = subprocess.run([venv_interpreter(cfg), "-I", "-m", "venv", staging], env=CLEAN_ENV,
                          cwd="/", capture_output=True, check=False)
    if made.returncode:
        # venv prints its "ensurepip is not available" refusal on stdout.
        raise Refused(f"could not create the reviewers' venv: {tail(made.stderr or made.stdout)}. "
                      f"Nothing that is live was replaced.")
    pip_env = dict(CLEAN_ENV, PIP_NO_INPUT="1", PIP_DISABLE_PIP_VERSION_CHECK="1",
                   PIP_NO_CACHE_DIR="1", PIP_CONFIG_FILE=os.devnull)
    pip = subprocess.run(
        [os.path.join(staging, "bin", "python"), "-I", "-m", "pip", "install",
         "--only-binary=:all:", "--require-hashes", *cfg["pip_args"], "-r", lock],
        env=pip_env, cwd="/", capture_output=True, check=False)
    if pip.returncode:
        raise Refused(f"pip refused {LOCK} (a hash did not match, or a build failed): "
                      f"{tail(pip.stdout + pip.stderr)}. Nothing that is live was replaced.")
    own_tree(staging)


def fetch_claude(cfg: dict, ap_tree: str) -> tuple[str, str]:
    """Download the pinned Claude binary as a scratch file that cannot run, check its hash, then run
    it once with --version. Returns the scratch path and the --version line. The caller stages the
    file; a refusal here removes it."""
    version, pins = parse_pin(read_tree_file(ap_tree, PIN).decode("utf-8"))
    which = claude_platform()
    if which not in pins:
        raise Refused(f"the pin in {PIN} has no sha256 for {which}.")
    expected = pins[which]
    scratch_dir = os.path.join(cfg["prefix"], "scratch")
    make_dir(scratch_dir, 0o700)
    url = f"{cfg['download_base'].rstrip('/')}/{version}/{which}/claude"
    scratch = os.path.join(scratch_dir, f"claude-{token()}")
    fd = os.open(scratch, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    digest = hashlib.sha256()
    with os.fdopen(fd, "wb") as out:
        os.fchown(fd, gg.ROOT_UID, gg.ROOT_GID)
        try:
            with urllib.request.urlopen(url, timeout=600) as resp:
                for chunk in iter(lambda: resp.read(1 << 20), b""):
                    digest.update(chunk)
                    out.write(chunk)
        except OSError as exc:
            os.unlink(scratch)
            raise Refused(f"could not download {url}: {exc}. Nothing was run.")
    got = digest.hexdigest()
    if got != expected:
        os.unlink(scratch)
        raise Refused(f"{url} has sha256 {got}, and the pin says {expected}. Nothing was run, "
                      f"and the download was deleted.")
    os.chmod(scratch, 0o755)
    try:
        ran = subprocess.run([scratch, "--version"], env=CLEAN_ENV, cwd="/", capture_output=True,
                             timeout=CLAUDE_VERSION_TIMEOUT, check=False)
    except subprocess.TimeoutExpired:
        os.unlink(scratch)
        raise Refused(f"the pinned binary did not finish --version within {CLAUDE_VERSION_TIMEOUT}s. "
                      f"It was removed.")
    text = ran.stdout.decode("utf-8", "replace")
    words = text.split()
    if ran.returncode or not words or words[0] != version:
        os.unlink(scratch)
        raise Refused(f"the pinned binary did not report {version} as the first word of --version "
                      f"(exit {ran.returncode}). It was removed.")
    return scratch, text.strip()


# The pinned macOS Python (decision 3): a checksum-verified standalone CPython,
# extracted under the prefix so a service account's venv can be built on an
# interpreter `agents` cannot change.

def checked_tar_members(dest: str, tar: tarfile.TarFile) -> list:
    """Every member of `tar`, refused if its own path escapes `dest`, or if a symbolic
    link's target does. Unlike extract()'s git trees, where any link at all is refused,
    a symbolic link that stays inside `dest` is kept: the archive's own links (such as
    `bin/python3`) must reach their targets in the extracted tree."""
    members = []
    for member in tar.getmembers():
        name = member.name
        if os.path.isabs(name):
            raise Refused(f"{name} in the Python archive is an absolute path. Nothing was changed.")
        target = os.path.normpath(os.path.join(dest, name))
        if target != dest and not target.startswith(dest + os.sep):
            raise Refused(f"{name} in the Python archive escapes {dest}. Nothing was changed.")
        if member.issym():
            link = member.linkname
            resolved = (os.path.normpath(link) if os.path.isabs(link)
                       else os.path.normpath(os.path.join(os.path.dirname(target), link)))
            if resolved != dest and not resolved.startswith(dest + os.sep):
                raise Refused(f"{name} in the Python archive links outside {dest}. "
                              f"Nothing was changed.")
        members.append(member)
    return members


def pinned_python_prints(interpreter: str) -> bool:
    """True when `interpreter --version` reports exactly PYTHON_VERSION."""
    try:
        ran = subprocess.run([interpreter, "--version"], env=CLEAN_ENV, cwd="/",
                             capture_output=True, timeout=CLAUDE_VERSION_TIMEOUT, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return False
    if ran.returncode:
        return False
    words = ran.stdout.decode("utf-8", "replace").split()
    return len(words) >= 2 and words[0] == "Python" and words[1] == PYTHON_VERSION


def fetch_pinned_python(prefix: str) -> str:
    """Download the pinned Python tarball to a root-owned scratch file under `prefix`,
    checking its sha256 before anything is opened. Returns the scratch path; the
    caller removes it."""
    scratch_dir = os.path.join(prefix, "scratch")
    make_dir(scratch_dir, 0o700)
    scratch = os.path.join(scratch_dir, f"python-{token()}.tar.gz")
    fd = os.open(scratch, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    digest = hashlib.sha256()
    with os.fdopen(fd, "wb") as out:
        os.fchown(fd, gg.ROOT_UID, gg.ROOT_GID)
        try:
            with urllib.request.urlopen(PYTHON_URL, timeout=600) as resp:
                for chunk in iter(lambda: resp.read(1 << 20), b""):
                    digest.update(chunk)
                    out.write(chunk)
        except OSError as exc:
            os.unlink(scratch)
            raise Refused(f"could not download {PYTHON_URL}: {exc}. Nothing was changed.")
    got = digest.hexdigest()
    if got != PYTHON_SHA256:
        os.unlink(scratch)
        raise Refused(f"{PYTHON_URL} has sha256 {got}, and the pin says {PYTHON_SHA256}. "
                      f"Nothing was changed, and the download was deleted.")
    return scratch


def install_pinned_python(cfg: dict) -> None:
    """On a Mac, extract the pinned CPython standalone build under the prefix, so a
    service account's venv can be built on an interpreter `agents` cannot change.
    Linux installs nothing here: root's system interpreter already passes
    serve.sh's walk. A directory already there, with a passing version check,
    needs no download."""
    if platform_mod.system() != "Darwin":
        return
    prefix = cfg["prefix"]
    pydir = os.path.join(prefix, "python")
    dest = os.path.join(pydir, PYTHON_VERSION)
    interpreter = os.path.join(dest, "bin", "python3.11")
    if os.path.lexists(dest):
        if not os.path.isdir(dest) or os.path.islink(dest):
            raise Refused(f"{dest} is not a plain directory. Nothing was changed.")
        if pinned_python_prints(interpreter):
            return
        raise Refused(f"{dest} exists, and {interpreter} does not report {PYTHON_VERSION}. "
                      f"Fix or remove it by hand. Nothing was changed.")
    make_dir(pydir, 0o755)
    scratch = fetch_pinned_python(prefix)
    staged_parent = f"{dest}.tmp-{token()}"
    os.mkdir(staged_parent, 0o755)
    try:
        with tarfile.open(scratch, "r:gz") as tar:
            tar.extractall(path=staged_parent, members=checked_tar_members(staged_parent, tar))
    except BaseException:
        os.unlink(scratch)
        shutil.rmtree(staged_parent, ignore_errors=True)
        raise
    os.unlink(scratch)
    extracted = os.path.join(staged_parent, "python")
    if not os.path.isdir(extracted) or os.path.islink(extracted):
        shutil.rmtree(staged_parent, ignore_errors=True)
        raise Refused("the Python archive has no top-level python/ directory. Nothing was changed.")
    own_tree(extracted)
    os.rename(extracted, dest)
    shutil.rmtree(staged_parent, ignore_errors=True)
    if not pinned_python_prints(interpreter):
        shutil.rmtree(dest, ignore_errors=True)
        raise Refused(f"{interpreter} does not report {PYTHON_VERSION} after being installed. "
                      f"Nothing is left at {dest}.")
    print(f"python: {PYTHON_VERSION} at {dest}")


def stage_reviewers(cfg: dict, args, ap_tree: str, sw_tree: str, plan: Plan) -> None:
    rv = os.path.join(cfg["prefix"], "reviewers")
    make_dir(rv, 0o755)
    make_dir(os.path.join(rv, "bin"), 0o755)
    make_dir(os.path.join(rv, "lib"), 0o755)
    # projects.py reads this path first. Empty, it does not parse, so every reader raises and
    # fails closed. It holds no data, so it cannot go stale the way a copy of the registry can.
    make_dir(os.path.join(rv, "config"), 0o755)
    stage_file(plan, os.path.join(rv, "config", "projects.json"), b"", 0o644)
    for rel in REVIEWER_BINS:
        stage_file(plan, os.path.join(rv, "bin", os.path.basename(rel)),
                   read_tree_file(ap_tree, rel), 0o755)
    stage_library(plan, ap_tree, os.path.join(rv, "lib", "agent-platform"))
    stage_instructions(cfg, args, sw_tree, rv, plan)
    stage_venv(cfg, ap_tree, rv, plan)
    scratch, text = fetch_claude(cfg, ap_tree)
    plan.stage(scratch, os.path.join(rv, "claude"))
    print(f"reviewers: {text}")


# The updater and the handoff.

def write_updater(prefix: str, interpreter: str, sha: str, shape: str) -> None:
    target = os.path.join(prefix, "src", f"shipwright@{sha}", "bin", "install-privileged")
    text = (f"#!/bin/sh\n"
            f"exec {' '.join(ENTRY_ARGV)} {shlex.quote(interpreter)} -I {shlex.quote(target)} "
            f"--shape {shape}\n")
    write_atomic(os.path.join(prefix, "libexec", "update-privileged"), text.encode("utf-8"), 0o755)
    write_deploy_entry(prefix, interpreter, sha)


def write_deploy_entry(prefix: str, interpreter: str, sha: str) -> None:
    """`libexec/orient-deploy`, which execs this tree's `orient-deploy` under the
    cleared environment. Written on every install, so the root job always runs
    the newest tree's copy; the program itself does nothing unless install.json
    turns the deploy step on. `SUDO_USER` alone is carried through, so a person's
    `--accept` records who ran it."""
    target = os.path.join(prefix, "src", f"shipwright@{sha}", "bin", "orient-deploy")
    text = (f"#!/bin/sh\n"
            f"exec {' '.join(ENTRY_ARGV)} \"SUDO_USER=${{SUDO_USER:-}}\" "
            f"{shlex.quote(interpreter)} -I {shlex.quote(target)} \"$@\"\n")
    write_atomic(os.path.join(prefix, DEPLOY_ENTRY), text.encode("utf-8"), 0o755)


def web_flow_keyring(sw_tree: str) -> bytes:
    """The web-flow public key this tree ships, refused when it is missing."""
    return read_tree_file(sw_tree, WEB_FLOW_SOURCE)


def hand_off(cfg: dict, args, sw_tree: str, shas: dict[str, str], tag: str | None = None) -> int:
    """Run the newer commit's own copy, which installs and rewrites the entry point.
    `tag`, given on the anonymous path, is carried on so the newer copy runs that same
    path rather than falling back to a token fetch."""
    argv = [*ENTRY_ARGV, cfg["interpreter"], "-I",
            os.path.join(sw_tree, "bin", "install-privileged"), "--shape", cfg["shape"],
            "--consent", args.consent]
    if tag:
        argv += ["--release", tag]
    for repo, sha in sorted(shas.items()):
        argv += ["--commit", f"{repo}={sha}"]
    print(f"{PROG}: handing off to {sw_tree}")
    return subprocess.run(argv, cwd="/", check=False).returncode


# Where a three-account job's logs go: `bin/stand-up-backend` passes this as
# install-jobs' `--log-dir`. The directory is root's, but install-jobs'
# `make_account_log` hands each file in it to the job's account by descriptor,
# so the account can write its own log and cannot create, rename or re-point an
# entry. Those files are the only paths under the prefix that another account
# owns by design.
LOG_DIR = os.path.join("var", "log")

# Where Orient's socket directory lives, relative to the prefix, and the exact
# mode it must carry: `bin/provision-accounts` creates {prefix}/run/orient
# itself, owned by Orient's own account, group ORIENT_TUNNEL_GROUP, mode
# 0o750. ORIENT_SOCKET_DIR_MODE is duplicated from provision-accounts' own
# constant of the same name the way ORIENT_ACCOUNT_NAMES above is:
# tools/test_install_privileged.py checks that it agrees too.
ORIENT_SOCKET_DIR = os.path.join("run", "orient")
ORIENT_SOCKET_DIR_MODE = 0o750


def verify_ownership(prefix: str) -> list[str]:
    """Every path under the prefix owned by root with no group or other write bit,
    except the job logs directly inside {prefix}/var/log, and {prefix}/run/orient
    itself.

    **A JOB'S LOG FILE BELONGS TO ITS ACCOUNT.** Without this exception every run
    after the jobs first started refused here, on the agents-owned logs install-jobs
    had made, so neither an update nor a rerun of the privileged half could ever
    finish (Debian upgrade rehearsal, 2026-11-15). Root never executes or trusts a
    log. The exception covers only a regular file with one link and no group or
    other write bit, directly in that directory; the directory itself, anything
    nested in it and anything else under the prefix must still be root's.

    **ORIENT'S SOCKET DIRECTORY BELONGS TO ORIENT.** Without this exception every
    three-account install, and every update's privileged step, refused here on
    {prefix}/run/orient, the socket directory bin/provision-accounts creates and
    owns as Orient on purpose (Debian rehearsal, 2026-11-19). The exception
    covers only that one path, and only when it is a real directory (not a
    symlink) owned by Orient's own account, with group ORIENT_TUNNEL_GROUP and
    at EXACTLY mode ORIENT_SOCKET_DIR_MODE, the same mode provision-accounts'
    own add_dir_rows compares against, never merely clear of the group and
    other write bits: uvicorn makes the socket inside it mode 0666, so this
    directory's mode is the only thing that decides who can reach it, and a
    looser mode such
    as 0755 would pass a write-bit-only check while letting any local account
    connect. Anything else there is refused with a message naming the mode it
    must read and the mode it actually reads. Root never executes or reads
    anything there, so this walk does not descend into it: the socket Orient
    creates inside it is never checked. {prefix}/run itself, and everything
    else under the prefix, must still be root's.
    """
    bad: list[str] = []
    log_dir = os.path.join(prefix, LOG_DIR)
    orient_dir = os.path.join(prefix, ORIENT_SOCKET_DIR)
    orient_uid, tunnel_gid = orient_identity()
    top = os.lstat(prefix)
    if top.st_uid != gg.ROOT_UID or top.st_mode & 0o022:
        bad.append(prefix)
    for dirpath, dirnames, filenames in os.walk(prefix):
        for name in list(dirnames):
            path = os.path.join(dirpath, name)
            if path != orient_dir:
                continue
            dirnames.remove(name)
            st = os.lstat(path)
            found_mode = stat.S_IMODE(st.st_mode)
            if not stat.S_ISDIR(st.st_mode):
                bad.append(f"{path} is not a plain directory")
            elif (orient_uid is None or st.st_uid != orient_uid
                  or tunnel_gid is None or st.st_gid != tunnel_gid):
                bad.append(f"{path} is not owned by Orient's own account and the "
                           f"{ORIENT_TUNNEL_GROUP} group")
            elif found_mode != ORIENT_SOCKET_DIR_MODE:
                bad.append(f"{path} must read exactly mode {ORIENT_SOCKET_DIR_MODE:04o} "
                           f"(reads {found_mode:04o})")
        for name in dirnames + filenames:
            path = os.path.join(dirpath, name)
            st = os.lstat(path)
            if (dirpath == log_dir and stat.S_ISREG(st.st_mode) and st.st_nlink == 1
                    and not st.st_mode & 0o022):
                continue
            if st.st_uid != gg.ROOT_UID or (not stat.S_ISLNK(st.st_mode) and st.st_mode & 0o022):
                bad.append(path)
    return bad


# The run.

def stage_previous_records(prefix: str, new_records: bytes, plan: Plan) -> None:
    """Stage the current `src/installed`, before this run replaces it, as
    `src/installed.previous` — in the same swap as the new record, so
    `--restore-previous` can later read what this run is about to replace.
    A first install, with no `src/installed` yet, stages nothing, and nor
    does a replay whose new record is byte-identical to the current one: it
    replaces nothing, so there is nothing to save as what it replaced."""
    current = read_beneath(prefix, ("src", "installed"), one_name=True)
    if current is not None and current != new_records:
        stage_file(plan, os.path.join(prefix, "src", PREVIOUS_RECORDS_NAME), current, 0o644)


def stage_all(cfg: dict, args, sw_tree: str, ap_tree: str, ap_sha: str, records: str, plan: Plan) -> None:
    prefix = cfg["prefix"]
    libexec = os.path.join(prefix, "libexec")
    make_dir(libexec, 0o755)
    launcher = os.path.join(libexec, "review-launch")
    stage_file(plan, launcher, rewrite_launcher_shebang(read_tree_file(ap_tree, LAUNCHER), cfg["interpreter"]),
               0o755)
    print(f"launcher: agent-platform@{ap_sha} {LAUNCHER} -> libexec/review-launch, "
          f"shebang {cfg['interpreter']} -I")
    # The tool and the directory it writes in, and never the record itself: only
    # `model-provider enable` or `disable` under sudo can name the operator and
    # the time, so an install enables no provider.
    stage_file(plan, os.path.join(libexec, "model-provider"),
               read_tree_file(ap_tree, MODEL_PROVIDER), 0o755)
    make_dir(os.path.join(prefix, "config"), 0o755)
    print(f"model-provider: agent-platform@{ap_sha} {MODEL_PROVIDER} -> libexec/model-provider")
    make_dir(os.path.join(prefix, "lib"), 0o755)
    stage_library(plan, ap_tree, os.path.join(prefix, "lib", "agent-platform"))
    stage_sudo_rule(cfg, sw_tree, launcher, plan)
    print(f"sudo rule: {cfg['sudoers_dir']}/{SUDOERS_NAME}")
    stage_reviewers(cfg, args, ap_tree, sw_tree, plan)
    stage_file(plan, os.path.join(prefix, WEB_FLOW_KEYRING), web_flow_keyring(sw_tree), 0o644)
    print(f"web-flow keyring: {WEB_FLOW_SOURCE} -> {WEB_FLOW_KEYRING}")
    new_records = records.encode("utf-8")
    stage_previous_records(prefix, new_records, plan)
    stage_file(plan, os.path.join(prefix, "src", "installed"), new_records, 0o644)


def stage_restore_three(cfg: dict, sw_tree: str, ap_tree: str, ap_sha: str, records: str, plan: Plan) -> None:
    """Reinstall exactly the parts of `stage_all` that read nothing but the
    trees already on the machine: the review launcher, the model-provider
    tool, root's own copy of agent-platform's library, the sudo rule and the
    web-flow keyring. The reviewers' own venv, Claude binary and instruction
    file are left as they are — rebuilding them needs the network, and
    `--restore-previous` fetches nothing."""
    prefix = cfg["prefix"]
    libexec = os.path.join(prefix, "libexec")
    make_dir(libexec, 0o755)
    launcher = os.path.join(libexec, "review-launch")
    stage_file(plan, launcher, rewrite_launcher_shebang(read_tree_file(ap_tree, LAUNCHER), cfg["interpreter"]),
               0o755)
    print(f"launcher: agent-platform@{ap_sha} {LAUNCHER} -> libexec/review-launch, "
          f"shebang {cfg['interpreter']} -I")
    stage_file(plan, os.path.join(libexec, "model-provider"),
               read_tree_file(ap_tree, MODEL_PROVIDER), 0o755)
    make_dir(os.path.join(prefix, "config"), 0o755)
    print(f"model-provider: agent-platform@{ap_sha} {MODEL_PROVIDER} -> libexec/model-provider")
    make_dir(os.path.join(prefix, "lib"), 0o755)
    stage_library(plan, ap_tree, os.path.join(prefix, "lib", "agent-platform"))
    stage_sudo_rule(cfg, sw_tree, launcher, plan)
    print(f"sudo rule: {cfg['sudoers_dir']}/{SUDOERS_NAME}")
    stage_file(plan, os.path.join(prefix, WEB_FLOW_KEYRING), web_flow_keyring(sw_tree), 0o644)
    print(f"web-flow keyring: {WEB_FLOW_SOURCE} -> {WEB_FLOW_KEYRING}")
    stage_file(plan, os.path.join(prefix, "src", "installed"), records.encode("utf-8"), 0o644)


def stage_restore_two(cfg: dict, ap_tree: str, ap_sha: str, sw_tree: str, records: str, plan: Plan) -> None:
    """Reinstall exactly the parts `install_two` itself places: model-provider
    and the web-flow keyring, from the trees already on the machine. Shape
    two carries no review launcher, no root-owned library mirror and no sudo
    rule — see `install_two` — so none of those is staged here either.
    Fetches nothing and makes no git call."""
    prefix = cfg["prefix"]
    make_dir(os.path.join(prefix, "libexec"), 0o755)
    stage_file(plan, os.path.join(prefix, "libexec", "model-provider"),
               read_tree_file(ap_tree, MODEL_PROVIDER), 0o755)
    print(f"model-provider: agent-platform@{ap_sha} {MODEL_PROVIDER} -> libexec/model-provider")
    stage_file(plan, os.path.join(prefix, WEB_FLOW_KEYRING), web_flow_keyring(sw_tree), 0o644)
    print(f"web-flow keyring: {WEB_FLOW_SOURCE} -> {WEB_FLOW_KEYRING}")
    stage_file(plan, os.path.join(prefix, "src", "installed"), records.encode("utf-8"), 0o644)


def install(args: argparse.Namespace) -> int:
    # Every root child, github-gate's openssl included, inherits a root-owned working directory.
    os.chdir("/")
    euid = os.geteuid()
    gg.ROOT_UID, gg.ROOT_GID = (0, 0) if euid == 0 else (euid, os.getegid())
    prefix = RUN_PREFIX
    cfg = merged_config(load_config(prefix), fixture_settings(prefix), args)
    cfg["prefix"] = prefix
    if euid != 0 and cfg["require_root"]:
        raise Refused("this installs the root-owned half, and only root may run it. "
                      "Run it with sudo.")
    print(f"{PROG}: running {HERE_FILE}")
    if args.restore_previous:
        return restore_previous(cfg, args)
    if cfg["shape"] == "two":
        return install_two(cfg, args)
    return install_three(cfg, args)


def latest_recorded_tag(records: str) -> str | None:
    """The most recent tag name in `src/installed`, or None when no tag is recorded.
    Reads the repository-qualified form (`tag <repo> <tag> <sha>`) only; every
    repository an anonymous install records is tagged alike, so the tag name alone
    is enough to replay it."""
    tag = None
    for line in records.splitlines():
        fields = line.split()
        if len(fields) == 4 and fields[0] == "tag" and TAG.fullmatch(fields[2]):
            tag = fields[2]
    return tag


def install_two(cfg: dict, args: argparse.Namespace) -> int:
    """The root half that holds all four repositories: fetch each anonymously by
    tag, except convivy-orient's fallback to a minted token, extract each tree,
    place model-provider and the entry point, and record what was installed.

    `--commit <repo>=<sha>`, one per repository and optional, is checked
    against each tag's own commit before anything is fetched from that
    repository — the same check shape three's anonymous path makes
    (`fetch_release_tag`'s `expected`). Refused together with a plain
    replay, which carries no `--release` to check it against, so a stray
    `--commit` is never silently ignored."""
    if args.consent is not None:
        raise Refused(f"--consent is not taken by shape two. The instruction-file "
                      f"diff is a shape-three step. Nothing was changed.")
    names = {r: cfg[f"{r.replace('-', '_')}_repo"] for r in ROLES}
    commits = parse_commits(args.commit, names)
    prefix = cfg["prefix"]

    # When --release is not given, the updater is replaying the recorded shape.
    # Read the tag the last install recorded. Resolved, and `--commit` checked
    # against it, before anything is created: a refusal here must leave even
    # the settings file and the directories untouched.
    installed_path = os.path.join(prefix, "src", "installed")
    prior_records = (read_beneath(prefix, ("src", "installed")) or b"").decode("utf-8") \
        if os.path.lexists(installed_path) else ""
    if args.release:
        tag = parse_release_tag(args.release)
    else:
        if commits:
            raise Refused(f"--commit names a commit to check against a tag, and no --release "
                          f"names a tag to check it against. Nothing was changed.")
        tag = latest_recorded_tag(prior_records)
        if not tag:
            raise Refused("name the release tag with --release (e.g. v1.0.0). Nothing was changed.")

    make_dir(prefix, 0o755)
    make_dir(os.path.join(prefix, "src"), 0o755)
    make_dir(os.path.join(prefix, "libexec"), 0o755)
    # Shape two never acts on entities, but an operator may still have
    # hand-placed the key; validated the same way shape three validates it,
    # and carried forward byte-for-byte rather than silently dropped.
    stored = load_config(prefix)
    if ENTITIES_KEY in stored:
        try:
            ae.read_entities(os.path.join(prefix, CONFIG))
        except ae.EntitiesInvalid as exc:
            raise Refused(str(exc))
    persisted = persisted_two(stored, cfg, prefix)
    data = (json.dumps(persisted, indent=2, sort_keys=True) + "\n").encode("utf-8")
    if read_beneath(prefix, (CONFIG,)) != data:
        write_atomic(os.path.join(prefix, CONFIG), data, 0o644)

    sw_name = cfg["shipwright_repo"]
    sw_url = f"{cfg['github_base'].rstrip('/')}/{cfg['org']}/{sw_name}"
    sw_bare = os.path.join(prefix, "src", f"{sw_name}.git")
    sw_peeled = fetch_release_tag(sw_bare, sw_name, sw_url, tag, prior_records, commits.get(sw_name))
    sw_tree = extract(prefix, sw_bare, sw_name, sw_peeled)
    print(f"source: {sw_name} at {sw_peeled} from {sw_tree}")

    if RUN_SHA != sw_peeled:
        return hand_off_two(cfg, args, sw_tree, tag)

    # convivy-orient's credential need is resolved next, before agent-platform
    # or library is fetched, so a missing key refuses before anything else
    # (beyond shipwright, needed to reach this copy) is fetched.
    orient_name = cfg["convivy_orient_repo"]
    orient_url = f"{cfg['github_base'].rstrip('/')}/{cfg['org']}/{orient_name}"
    orient_token, orient_revoke = convivy_orient_token(cfg, prefix, orient_name, orient_url, tag)

    # The token exists from here on, so everything up to the end of the
    # convivy-orient fetch sits inside the `try`: a refusal from the
    # agent-platform or library fetch below revokes it too.
    try:
        ap_name = cfg["agent_platform_repo"]
        ap_url = f"{cfg['github_base'].rstrip('/')}/{cfg['org']}/{ap_name}"
        ap_bare = os.path.join(prefix, "src", f"{ap_name}.git")
        ap_peeled = fetch_release_tag(ap_bare, ap_name, ap_url, tag, prior_records, commits.get(ap_name))
        ap_tree = extract(prefix, ap_bare, ap_name, ap_peeled)
        print(f"source: {ap_name} at {ap_peeled} from {ap_tree}")

        lib_name = cfg["library_repo"]
        lib_url = f"{cfg['github_base'].rstrip('/')}/{cfg['org']}/{lib_name}"
        lib_bare = os.path.join(prefix, "src", f"{lib_name}.git")
        lib_peeled = fetch_release_tag(lib_bare, lib_name, lib_url, tag, prior_records, commits.get(lib_name))
        lib_tree = extract(prefix, lib_bare, lib_name, lib_peeled)
        print(f"source: {lib_name} at {lib_peeled} from {lib_tree}")

        orient_bare = os.path.join(prefix, "src", f"{orient_name}.git")
        orient_peeled = fetch_release_tag(orient_bare, orient_name, orient_url, tag, prior_records,
                                          commits.get(orient_name), token_value=orient_token)
    finally:
        if orient_revoke is not None:
            orient_revoke(orient_token)
    orient_tree = extract(prefix, orient_bare, orient_name, orient_peeled)
    print(f"source: {orient_name} at {orient_peeled} from {orient_tree}")

    install_pinned_python(cfg)
    records = (f"tag {sw_name} {tag} {sw_peeled}\n{sw_name} {sw_peeled}\n"
              f"tag {ap_name} {tag} {ap_peeled}\n{ap_name} {ap_peeled}\n"
              f"tag {lib_name} {tag} {lib_peeled}\n{lib_name} {lib_peeled}\n"
              f"tag {orient_name} {tag} {orient_peeled}\n{orient_name} {orient_peeled}\n")
    if platform_mod.system() == "Darwin":
        records += f"python {PYTHON_VERSION} {PYTHON_SHA256}\n"
    keyring = web_flow_keyring(sw_tree)
    make_dir(os.path.join(prefix, "etc"), 0o700)
    write_atomic(os.path.join(prefix, WEB_FLOW_KEYRING), keyring, 0o644)
    print(f"web-flow keyring: {WEB_FLOW_SOURCE} -> {WEB_FLOW_KEYRING}")
    write_atomic(os.path.join(prefix, "libexec", "model-provider"),
                read_tree_file(ap_tree, MODEL_PROVIDER), 0o755)
    print(f"model-provider: {ap_name}@{ap_peeled} {MODEL_PROVIDER} -> libexec/model-provider")
    # Saved before it is replaced, the same way `stage_previous_records` saves
    # shape three's, so `--restore-previous` has something to read back: a
    # first install, with no `src/installed` yet, saves nothing, and nor does
    # a replay whose new record is byte-identical to the current one.
    new_records = records.encode("utf-8")
    current_records = read_beneath(prefix, ("src", "installed"))
    if current_records is not None and current_records != new_records:
        write_atomic(os.path.join(prefix, "src", PREVIOUS_RECORDS_NAME), current_records, 0o644)
    write_atomic(os.path.join(prefix, "src", "installed"), new_records, 0o644)
    write_updater(prefix, cfg["interpreter"], sw_peeled, cfg["shape"])
    print(f"installed: {sw_name}@{sw_peeled}, {ap_name}@{ap_peeled}, {lib_name}@{lib_peeled}, "
          f"{orient_name}@{orient_peeled}; entry point "
          f"{os.path.join(prefix, 'libexec', 'update-privileged')}")
    return 0


def hand_off_two(cfg: dict, args, sw_tree: str, tag: str) -> int:
    """Run the newer commit's own copy on the shape-two path. Any `--commit` pins
    are carried on unchanged, so the newer copy still checks agent-platform,
    library and convivy-orient against them when it fetches those repositories."""
    argv = [*ENTRY_ARGV, cfg["interpreter"], "-I",
            os.path.join(sw_tree, "bin", "install-privileged"),
            "--shape", cfg["shape"], "--release", tag]
    for item in args.commit:
        argv += ["--commit", item]
    print(f"{PROG}: handing off to {sw_tree}")
    return subprocess.run(argv, cwd="/", check=False).returncode


def install_three(cfg: dict, args: argparse.Namespace) -> int:
    prefix = cfg["prefix"]
    if args.consent is None:
        args.consent = "ask"
    names = {r: cfg[f"{r.replace('-', '_')}_repo"] for r in ROLES}
    commits = parse_commits(args.commit, names)

    release_tag = None
    if args.release:
        release_tag = parse_release_tag(args.release)
        missing = sorted(set(names.values()) - set(commits))
        if missing:
            raise Refused(f"--release names a tag, and shape three then needs --commit for "
                          f"every repository it names; missing: {', '.join(missing)}. "
                          f"Nothing was changed.")

    cfg["library_account"] = library_account(cfg)
    make_dir(prefix, 0o755)
    make_dir(os.path.join(prefix, "etc"), 0o700)
    make_dir(os.path.join(prefix, "src"), 0o755)
    # Validated and carried through `cfg` for `stage_sudo_rule`, and carried
    # back into install.json byte-for-byte below so a later run reads the
    # same entities this one did, never a freshly fabricated `["default"]`.
    stored = load_config(prefix)
    try:
        cfg["entities"] = ae.read_entities(os.path.join(prefix, CONFIG))
    except ae.EntitiesInvalid as exc:
        raise Refused(str(exc))
    persisted = persisted_three(stored, cfg, prefix)
    data = (json.dumps(persisted, indent=2, sort_keys=True) + "\n").encode("utf-8")
    if read_beneath(prefix, (CONFIG,)) != data:
        write_atomic(os.path.join(prefix, CONFIG), data, 0o644)

    # With no --release, the tag a previous anonymous install recorded selects the path,
    # so a bare `--shape three` replay, which is what the entry point runs, stays anonymous.
    installed_path = os.path.join(prefix, "src", "installed")
    prior_records = (read_beneath(prefix, ("src", "installed")) or b"").decode("utf-8") \
        if os.path.lexists(installed_path) else ""
    tag = release_tag or latest_recorded_tag(prior_records)

    if tag:
        return install_three_anonymous(cfg, args, names, commits, tag, prior_records)
    return install_three_token(cfg, args, names, commits)


def install_three_anonymous(cfg: dict, args: argparse.Namespace, names: dict[str, str],
                            commits: dict[str, str], tag: str, prior_records: str) -> int:
    """The three-account root half's anonymous path: each repository fetched over
    HTTPS by `tag`, needing no approver key."""
    prefix = cfg["prefix"]
    ensure_slots(prefix, cfg["entities"])

    trees: dict[str, tuple[str, str, str]] = {}
    for role in ROLES:
        name = names[role]
        url = f"{cfg['github_base'].rstrip('/')}/{cfg['org']}/{name}"
        bare = os.path.join(prefix, "src", f"{name}.git")
        peeled = fetch_release_tag(bare, name, url, tag, prior_records, commits.get(name))
        trees[role] = (name, peeled, extract(prefix, bare, name, peeled))
        print(f"source: {name} at {peeled} from {trees[role][2]}")
    install_pinned_python(cfg)
    return finish_three(cfg, args, trees, tag)


def install_three_token(cfg: dict, args: argparse.Namespace, names: dict[str, str],
                        commits: dict[str, str]) -> int:
    """The three-account root half's token path: each repository fetched as GitHub's
    own `main`, with a read token minted from the approver key."""
    prefix = cfg["prefix"]
    ensure_slots(prefix, cfg["entities"])
    key_path = os.path.join(prefix, gg.KEY_SLOT)
    if not gg.read_slot(key_path):
        raise Refused(f"no approver key is placed at {key_path}. The slots are created. Place "
                      f"the key with: sudo {shlex.quote(cfg['interpreter'])} -I "
                      f"{shlex.quote(os.path.join(HERE, 'github-gate'))} --place-key "
                      f"<file> --app-id <id>. Nothing was fetched.")
    key_path, app_id = gg.placed_key(prefix)
    jwt = gg.app_jwt(key_path, app_id)
    gh = gg.GitHub(api=cfg["api_base"])

    trees: dict[str, tuple[str, str, str]] = {}
    for role in ROLES:
        name = names[role]
        bare = os.path.join(prefix, "src", f"{name}.git")
        ensure_bare(bare)
        value = read_token(gh, jwt, cfg["org"], name)
        try:
            fetch_main(bare, f"{cfg['github_base'].rstrip('/')}/{cfg['org']}/{name}", value)
        finally:
            gh.revoke(value)
        head = main_head(bare)
        sha = commits.get(name, head)
        if not is_on_main(bare, sha):
            raise Refused(f"{sha} is not on {MAIN} of {name}, whose head GitHub gives as {head}. "
                          f"The fetch has already set the bare copy's {MAIN} to that head. Only a commit "
                          f"on {MAIN} is installed. Nothing was installed.")
        trees[role] = (name, sha, extract(prefix, bare, name, sha))
        print(f"source: {name} at {sha} from {trees[role][2]}")
    install_pinned_python(cfg)
    return finish_three(cfg, args, trees, None)


def finish_three(cfg: dict, args: argparse.Namespace,
                 trees: dict[str, tuple[str, str, str]], tag: str | None) -> int:
    """Hand off to a newer shipwright commit, or stage, swap and record what both
    three-account fetches extracted. `tag` is the anonymous path's release tag, and
    None on the token path, which records no tag."""
    prefix = cfg["prefix"]
    sw_name, sw_sha, sw_tree = trees["shipwright"]
    if RUN_SHA != sw_sha:
        return hand_off(cfg, args, sw_tree, {n: s for n, s, _ in trees.values()}, tag=tag)

    ap_name, ap_sha, ap_tree = trees["agent-platform"]
    lib_name, lib_sha, _lib_tree = trees["library"]
    orient_name, orient_sha, _orient_tree = trees["convivy-orient"]
    records = "".join((f"tag {n} {tag} {s}\n" if tag else "") + f"{n} {s}\n"
                      for n, s, _ in trees.values())
    if platform_mod.system() == "Darwin":
        records += f"python {PYTHON_VERSION} {PYTHON_SHA256}\n"
    plan = Plan()
    try:
        stage_all(cfg, args, sw_tree, ap_tree, ap_sha, records, plan)
    except BaseException:
        plan.discard()
        raise
    plan.swap()
    bad = verify_ownership(prefix)
    if bad:
        raise Refused("these paths are not root-owned, or another account can write them: "
                      + ", ".join(bad) + ". The entry point was not rewritten.")
    write_updater(prefix, cfg["interpreter"], sw_sha, cfg["shape"])
    print(f"installed: {sw_name}@{sw_sha}, {ap_name}@{ap_sha}, {lib_name}@{lib_sha}, "
          f"{orient_name}@{orient_sha}; entry point "
          f"{os.path.join(prefix, 'libexec', 'update-privileged')}")
    return 0


def previous_trees(prefix: str, records: str, names: dict[str, str]) -> dict[str, tuple[str, str, str]]:
    """Each role's `(name, sha, tree path)` the saved record names, checked that the
    tree exists and is root-owned — never read from, and never fetched.

    A refusal names every role that is missing a commit, missing its tree, or
    whose tree is not root-owned, and changes nothing.
    """
    trees: dict[str, tuple[str, str, str]] = {}
    problems: list[str] = []
    for role in ROLES:
        name = names[role]
        sha = last_recorded_commit(records, name)
        if sha is None:
            problems.append(f"{name}: the saved record names no commit for it")
            continue
        tree = os.path.join(prefix, "src", f"{name}@{sha}")
        if not os.path.isdir(tree) or os.path.islink(tree):
            problems.append(f"{name}: {tree} is missing")
            continue
        st = os.lstat(tree)
        if st.st_uid != gg.ROOT_UID or st.st_mode & 0o022:
            problems.append(f"{name}: {tree} is not root-owned, or another account can write it")
            continue
        trees[role] = (name, sha, tree)
    if problems:
        raise Refused("the saved record at src/" + PREVIOUS_RECORDS_NAME + " cannot be restored:\n"
                      + "\n".join(f"  {p}" for p in problems) + "\nNothing was changed.")
    return trees


def restore_previous(cfg: dict, args: argparse.Namespace) -> int:
    """Reinstall the root half `src/installed.previous` names, from the trees already
    on the machine. Fetches nothing and makes no git call."""
    prefix = cfg["prefix"]
    path = os.path.join(prefix, "src", PREVIOUS_RECORDS_NAME)
    if not os.path.lexists(path):
        raise Refused(f"no saved record of a replaced root half at {path}. Nothing was changed.")
    check_settings_file(path)
    records = (read_beneath(prefix, ("src", PREVIOUS_RECORDS_NAME), one_name=True) or b"").decode("utf-8")
    names = {r: cfg[f"{r.replace('-', '_')}_repo"] for r in ROLES}
    trees = previous_trees(prefix, records, names)
    sw_name, sw_sha, sw_tree = trees["shipwright"]
    if RUN_SHA != sw_sha:
        raise Refused(
            f"this copy is shipwright@{RUN_SHA}, and the saved record names {sw_sha} for "
            f"shipwright. Run --restore-previous from the tree src/{PREVIOUS_RECORDS_NAME} "
            f"names: sudo <python3> -I {os.path.join(prefix, 'src', f'shipwright@{sw_sha}', 'bin', PROG)} "
            f"--shape {cfg['shape']} --restore-previous. Nothing was changed.")
    ap_name, ap_sha, ap_tree = trees["agent-platform"]
    if cfg["shape"] == "three":
        try:
            cfg["entities"] = ae.read_entities(os.path.join(prefix, CONFIG))
        except ae.EntitiesInvalid as exc:
            raise Refused(str(exc))

    plan = Plan()
    try:
        if cfg["shape"] == "two":
            stage_restore_two(cfg, ap_tree, ap_sha, sw_tree, records, plan)
        else:
            stage_restore_three(cfg, sw_tree, ap_tree, ap_sha, records, plan)
    except BaseException:
        plan.discard()
        raise
    plan.swap()
    bad = verify_ownership(prefix)
    if bad:
        raise Refused("these paths are not root-owned, or another account can write them: "
                      + ", ".join(bad) + ". The entry point was not rewritten.")
    write_updater(prefix, cfg["interpreter"], sw_sha, cfg["shape"])
    print(f"restored: {sw_name}@{sw_sha}, {ap_name}@{ap_sha}; entry point "
          f"{os.path.join(prefix, 'libexec', 'update-privileged')}")
    return 0


def ensure_slots(prefix: str, entities: list[str]) -> None:
    """Each credential slot as an empty root-owned file, with a `.needed` marker beside it.
    One Claude-token slot per entity in `entities` once there is more than one."""
    for rel in (gg.KEY_SLOT, gg.ID_SLOT, *claude_slots(entities)):
        path = os.path.join(prefix, rel)
        if gg.read_slot(path) is None:
            write_atomic(path, b"", 0o600)
        marker = path + gg.NEEDED_SUFFIX
        # Only an empty slot is needed; a placed key must not regain its marker.
        if not gg.read_slot(path) and not os.path.lexists(marker):
            write_atomic(marker, f"{rel} is empty; the install needs it.\n".encode("utf-8"), 0o644)


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return install(args)
    except Refused as exc:
        print(f"{PROG}: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
